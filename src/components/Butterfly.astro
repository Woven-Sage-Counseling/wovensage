---
/**
 * Hero butterfly: Rive V2 visual inside the existing hero-local flight container.
 * Layered PNGs remain as a load-failure fallback only.
 */
interface Props {
  class?: string;
  /** Display width in CSS pixels (square artboard). */
  width?: number;
}

const { class: className = '', width = 120 } = Astro.props;
const PNG = '/animations/butterfly';
const RIVE_HREF = '/animations/woven-sage-butterfly-v2.riv?v=paid-1';
---

<link rel="preload" href={RIVE_HREF} as="fetch" crossorigin="anonymous" />

<div
  class:list={['ws-butterfly', className]}
  data-butterfly
  aria-hidden="true"
  style={`--ws-butterfly-size: ${width}px;`}
>
  <div class="ws-butterfly__art" data-butterfly-art>
    <canvas
      class="ws-butterfly__rive"
      data-butterfly-rive
      width={width}
      height={width}
    ></canvas>

    <!-- Fallback: hidden in static CSS; revealed only on Rive failure/timeout -->
    <div class="ws-butterfly__fallback" data-butterfly-fallback hidden>
      <img
        class="ws-butterfly__full"
        src={`${PNG}/full-butterfly.png`}
        alt=""
        width="2048"
        height="2048"
        draggable="false"
        decoding="async"
      />
      <div class="ws-butterfly__layers" data-butterfly-layers>
        <img
          class="ws-butterfly__layer ws-butterfly__wing ws-butterfly__wing--lower"
          src={`${PNG}/left-lower-wing.png`}
          alt=""
          width="2048"
          height="2048"
          draggable="false"
          decoding="async"
        />
        <img
          class="ws-butterfly__layer ws-butterfly__wing ws-butterfly__wing--lower"
          src={`${PNG}/right-lower-wing.png`}
          alt=""
          width="2048"
          height="2048"
          draggable="false"
          decoding="async"
        />
        <img
          class="ws-butterfly__layer ws-butterfly__wing ws-butterfly__wing--upper"
          src={`${PNG}/left-upper-wing.png`}
          alt=""
          width="2048"
          height="2048"
          draggable="false"
          decoding="async"
        />
        <img
          class="ws-butterfly__layer ws-butterfly__wing ws-butterfly__wing--upper"
          src={`${PNG}/right-upper-wing.png`}
          alt=""
          width="2048"
          height="2048"
          draggable="false"
          decoding="async"
        />
        <img
          class="ws-butterfly__layer ws-butterfly__body"
          src={`${PNG}/body-and-antennae.png`}
          alt=""
          width="2048"
          height="2048"
          draggable="false"
          decoding="async"
        />
      </div>
    </div>

    <noscript>
      <img
        class="ws-butterfly__noscript"
        src={`${PNG}/full-butterfly.png`}
        alt=""
        width="2048"
        height="2048"
        decoding="async"
      />
    </noscript>
  </div>
</div>

<style>
  .ws-butterfly {
    --ws-butterfly-size: 120px;
    position: absolute;
    left: 0;
    top: 0;
    z-index: 14;
    width: var(--ws-butterfly-size);
    height: var(--ws-butterfly-size);
    margin: 0;
    padding: 0;
    border: none;
    outline: none;
    box-shadow: none;
    background: transparent;
    background-color: transparent;
    pointer-events: auto;
    cursor: default;
    will-change: transform;
    touch-action: manipulation;
  }

  .ws-butterfly.is-inert {
    pointer-events: none;
  }

  .ws-butterfly__art {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    outline: none;
    box-shadow: none;
    background: transparent;
    background-color: transparent;
  }

  /* Canvas stays in-flow but invisible until Rive binds successfully */
  .ws-butterfly__rive {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    outline: none;
    box-shadow: none;
    background: transparent;
    background-color: transparent;
    pointer-events: none;
    opacity: 0;
  }

  .ws-butterfly.is-rive-ready .ws-butterfly__rive {
    opacity: 1;
  }

  /* Static default: never flash PNG while Rive is loading */
  .ws-butterfly__fallback {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    box-shadow: none;
    background: transparent;
  }

  .ws-butterfly.is-rive-fallback .ws-butterfly__fallback {
    display: block;
  }

  .ws-butterfly.is-rive-fallback .ws-butterfly__fallback[hidden] {
    display: block;
  }

  .ws-butterfly.is-rive-fallback .ws-butterfly__rive {
    display: none;
    opacity: 0;
  }

  .ws-butterfly__noscript {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border: none;
    background: transparent;
    pointer-events: none;
  }

  .ws-butterfly__layers,
  .ws-butterfly__full {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: none;
    box-shadow: none;
    background: transparent;
  }

  .ws-butterfly__layers {
    display: block;
  }

  .ws-butterfly__full {
    display: none;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
  }

  .ws-butterfly__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
    border: none;
    box-shadow: none;
    background: transparent;
  }

  .ws-butterfly__wing {
    transform-origin: 50% 47%;
    transform: scaleX(1);
  }

  .ws-butterfly__body {
    z-index: 5;
  }

  .ws-butterfly__wing--lower {
    z-index: 1;
  }

  .ws-butterfly__wing--upper {
    z-index: 2;
  }

  /* Fallback-only CSS flap when Rive failed and PNG is shown */
  .ws-butterfly.is-rive-fallback.is-flying .ws-butterfly__wing--upper {
    animation: ws-butterfly-flap-upper 0.38s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
  }

  .ws-butterfly.is-rive-fallback.is-flying .ws-butterfly__wing--lower {
    animation: ws-butterfly-flap-lower 0.38s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    animation-delay: 42ms;
  }

  .ws-butterfly.is-rive-fallback.is-flying.is-settling .ws-butterfly__wing--upper,
  .ws-butterfly.is-rive-fallback.is-flying.is-settling .ws-butterfly__wing--lower {
    animation-duration: 0.7s;
  }

  @keyframes ws-butterfly-flap-upper {
    0%,
    100% {
      transform: scaleX(1);
    }
    25% {
      transform: scaleX(0.18);
    }
    50% {
      transform: scaleX(1);
    }
    75% {
      transform: scaleX(0.18);
    }
  }

  @keyframes ws-butterfly-flap-lower {
    0%,
    100% {
      transform: scaleX(1);
    }
    25% {
      transform: scaleX(0.25);
    }
    50% {
      transform: scaleX(1);
    }
    75% {
      transform: scaleX(0.25);
    }
  }

  .ws-butterfly.is-reduced.is-rive-fallback .ws-butterfly__layers {
    display: none;
  }

  .ws-butterfly.is-reduced.is-rive-fallback .ws-butterfly__full {
    display: block;
  }

  @media (max-width: 640px) {
    .ws-butterfly {
      --ws-butterfly-size: 88px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ws-butterfly__rive {
      transition: none;
    }

    .ws-butterfly.is-rive-fallback.is-flying .ws-butterfly__wing--upper,
    .ws-butterfly.is-rive-fallback.is-flying .ws-butterfly__wing--lower {
      animation: none;
    }
  }
</style>

<script>
  import { Rive, Layout, Fit, Alignment } from '@rive-app/webgl2';
  import type { StateMachineInput } from '@rive-app/webgl2';

  type Point = { x: number; y: number };
  type Cell = { col: number; row: number; key: string };
  type Bounds = { minX: number; minY: number; maxX: number; maxY: number; size: number };
  type PickResult = {
    point: Point;
    cell: Cell;
    distance: number;
    reason: string;
  };

  const EDGE = 40;
  const MIN_TRAVEL_FLOOR = 160;
  const PROXIMITY = 56;
  const REARM_DISTANCE = 90;
  const LANDING_COOLDOWN_MS = 500;
  const CANDIDATES_PER_PASS = 100;
  const GRID_COLS = 4;
  const GRID_ROWS = 3;
  const FLIGHT_MIN_MS = 2500;
  const FLIGHT_MAX_MS = 4000;
  const SETTLE_MS_MIN = 300;
  const SETTLE_MS_MAX = 500;
  const MAX_TILT = 12;
  const IS_DEV = import.meta.env.DEV;

  const RIVE_SRC = '/animations/woven-sage-butterfly-v2.riv?v=paid-1';
  const RIVE_ARTBOARD = 'Butterfly';
  /** Preferred name from design docs; file currently ships as V2. */
  const RIVE_STATE_MACHINE_PREFERRED = 'Butterfly Controller';
  const RIVE_STATE_MACHINE_FALLBACK = 'Butterfly Controller V2';
  const RIVE_INPUT_FLYING = 'isFlying';
  const RIVE_INPUT_WING_ADJUST = 'wingAdjust';
  const WING_ADJUST_MIN_MS = 7000;
  const WING_ADJUST_MAX_MS = 15000;
  const RIVE_LOAD_TIMEOUT_MS = 8000;

  const hosts = document.querySelectorAll('[data-butterfly]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const clamp = (n: number, min: number, max: number) => Math.min(max, Math.max(min, n));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const rand = (min: number, max: number) => min + Math.random() * (max - min);
  const dist = (a: Point, b: Point) => Math.hypot(b.x - a.x, b.y - a.y);

  const devLog = (...args: unknown[]) => {
    if (IS_DEV) console.info('[butterfly]', ...args);
  };

  const sizeOf = (el: HTMLElement) => {
    const styles = getComputedStyle(el);
    const raw = styles.getPropertyValue('--ws-butterfly-size').trim();
    const parsed = Number.parseFloat(raw);
    if (Number.isFinite(parsed) && parsed > 0) return parsed;
    return el.getBoundingClientRect().width || 120;
  };

  /** Usable top-left positions inside the hero (hero-local px). */
  const heroBounds = (hero: HTMLElement, size: number): Bounds => {
    const w = hero.clientWidth;
    const h = hero.clientHeight;
    return {
      minX: EDGE,
      minY: EDGE,
      maxX: Math.max(EDGE, w - EDGE - size),
      maxY: Math.max(EDGE, h - EDGE - size),
      size,
    };
  };

  const preferredMinTravel = (hero: HTMLElement) =>
    Math.max(220, Math.min(hero.clientWidth, hero.clientHeight) * 0.22);

  const cellOf = (point: Point, bounds: Bounds): Cell => {
    const spanX = Math.max(1, bounds.maxX - bounds.minX);
    const spanY = Math.max(1, bounds.maxY - bounds.minY);
    const col = clamp(Math.floor(((point.x - bounds.minX) / spanX) * GRID_COLS), 0, GRID_COLS - 1);
    const row = clamp(Math.floor(((point.y - bounds.minY) / spanY) * GRID_ROWS), 0, GRID_ROWS - 1);
    return { col, row, key: `${col},${row}` };
  };

  /**
   * Content to avoid. Do NOT include `.home-landing__art` — it is full-bleed
   * (`inset: 0`) and would reject every candidate, forcing a center fallback.
   * The illustrated woman is handled via a contracted figure core below.
   */
  const avoidSelector = [
    '.home-landing__logo',
    '.home-landing__login',
    '.home-landing__title',
    '.home-landing__title-img',
    '.home-landing__cta',
    '.home-landing__consult',
    '.home-landing__scroll',
  ].join(',');

  const rectsOverlap = (a: DOMRect, b: DOMRect, pad = 16) =>
    !(
      a.right + pad < b.left ||
      a.left - pad > b.right ||
      a.bottom + pad < b.top ||
      a.top - pad > b.bottom
    );

  /**
   * The figure image bbox covers most of the hero (large transparent canvas).
   * Only reserve the right/central band where the woman actually sits.
   */
  const figureCoreRect = (hero: HTMLElement): DOMRect | null => {
    const figure = hero.querySelector('.home-landing__figure');
    if (!(figure instanceof Element)) return null;
    const r = figure.getBoundingClientRect();
    if (r.width < 2 || r.height < 2) return null;
    // Woman reads on the right half of the art; keep a generous vertical core.
    const left = r.left + r.width * 0.42;
    const top = r.top + r.height * 0.12;
    const width = r.width * 0.52;
    const height = r.height * 0.78;
    return new DOMRect(left, top, width, height);
  };

  /** Overlap test in viewport space; `local` is hero-local top-left. */
  const isSafeDestination = (
    hero: HTMLElement,
    local: Point,
    size: number,
  ) => {
    const hr = hero.getBoundingClientRect();
    const candidate = new DOMRect(hr.left + local.x, hr.top + local.y, size, size);

    const nodes = hero.querySelectorAll(avoidSelector);
    for (const node of nodes) {
      if (!(node instanceof Element)) continue;
      const r = node.getBoundingClientRect();
      if (r.width < 2 || r.height < 2) continue;
      if (rectsOverlap(candidate, r, 14)) return false;
    }

    const core = figureCoreRect(hero);
    if (core && rectsOverlap(candidate, core, 10)) return false;

    return true;
  };

  const wouldAlternate = (candidateKey: string, recentCells: string[]) => {
    if (recentCells.length < 2) return false;
    const current = recentCells[recentCells.length - 1]!;
    const previous = recentCells[recentCells.length - 2]!;
    return candidateKey === previous && current !== previous;
  };

  const pickWeighted = <T,>(items: T[], weightOf: (item: T) => number): T => {
    const weights = items.map((item) => Math.max(0.001, weightOf(item)));
    const total = weights.reduce((sum, w) => sum + w, 0);
    let r = Math.random() * total;
    for (let i = 0; i < items.length; i++) {
      r -= weights[i]!;
      if (r <= 0) return items[i]!;
    }
    return items[items.length - 1]!;
  };

  type Candidate = { point: Point; cell: Cell; distance: number; novel: boolean };

  const sampleCandidates = (
    hero: HTMLElement,
    from: Point,
    size: number,
    bounds: Bounds,
    minDist: number,
    recentCells: string[],
    requireNovelCell: boolean,
  ): Candidate[] => {
    const spanX = Math.max(1, bounds.maxX - bounds.minX);
    const spanY = Math.max(1, bounds.maxY - bounds.minY);
    const currentKey = recentCells[recentCells.length - 1];
    const found: Candidate[] = [];

    for (let i = 0; i < CANDIDATES_PER_PASS; i++) {
      const point = {
        x: bounds.minX + Math.random() * spanX,
        y: bounds.minY + Math.random() * spanY,
      };
      const distance = dist(from, point);
      if (distance < minDist) continue;
      if (!isSafeDestination(hero, point, size)) continue;

      const cell = cellOf(point, bounds);
      const novel = !recentCells.includes(cell.key) && cell.key !== currentKey;
      if (requireNovelCell && !novel) continue;
      if (wouldAlternate(cell.key, recentCells)) continue;

      found.push({ point, cell, distance, novel });
    }

    return found;
  };

  const pickDestination = (
    hero: HTMLElement,
    from: Point,
    size: number,
    recentCells: string[],
  ): PickResult => {
    const bounds = heroBounds(hero, size);
    const preferred = Math.min(
      preferredMinTravel(hero),
      Math.hypot(bounds.maxX - bounds.minX, bounds.maxY - bounds.minY) * 0.85,
    );
    const floor = Math.min(MIN_TRAVEL_FLOOR, preferred);

    const passes: Array<{ minDist: number; requireNovel: boolean; label: string }> = [
      { minDist: preferred, requireNovel: true, label: 'preferred-distance + novel cell' },
      { minDist: preferred, requireNovel: false, label: 'preferred-distance (cell soft)' },
      { minDist: floor, requireNovel: true, label: 'floor-distance + novel cell' },
      { minDist: floor, requireNovel: false, label: 'floor-distance' },
    ];

    for (const pass of passes) {
      const batch = sampleCandidates(
        hero,
        from,
        size,
        bounds,
        pass.minDist,
        recentCells,
        pass.requireNovel,
      );
      if (batch.length === 0) {
        devLog('pass empty — sampling more', pass.label, { minDist: pass.minDist });
        continue;
      }

      const chosen = pickWeighted(batch, (c) => {
        const distanceWeight = c.distance / Math.max(1, preferred);
        const noveltyWeight = c.novel ? 2.4 : recentCells.includes(c.cell.key) ? 0.35 : 1;
        const leaveBonus =
          recentCells[recentCells.length - 1] &&
          c.cell.key !== recentCells[recentCells.length - 1]
            ? 1.35
            : 1;
        return distanceWeight * noveltyWeight * leaveBonus;
      });

      return {
        point: chosen.point,
        cell: chosen.cell,
        distance: chosen.distance,
        reason:
          pass.label === 'preferred-distance + novel cell'
            ? 'primary'
            : `fallback: ${pass.label}`,
      };
    }

    for (let round = 0; round < 8; round++) {
      const batch = sampleCandidates(hero, from, size, bounds, floor, recentCells, false);
      if (batch.length > 0) {
        const chosen = pickWeighted(batch, (c) => c.distance);
        return {
          point: chosen.point,
          cell: chosen.cell,
          distance: chosen.distance,
          reason: `fallback: extended sampling round ${round + 1}`,
        };
      }
    }

    let best: Candidate | null = null;
    const spanX = Math.max(1, bounds.maxX - bounds.minX);
    const spanY = Math.max(1, bounds.maxY - bounds.minY);
    for (let i = 0; i < CANDIDATES_PER_PASS * 2; i++) {
      const point = {
        x: bounds.minX + Math.random() * spanX,
        y: bounds.minY + Math.random() * spanY,
      };
      if (!isSafeDestination(hero, point, size)) continue;
      const distance = dist(from, point);
      if (distance < floor && best) continue;
      if (!best || distance > best.distance) {
        best = { point, cell: cellOf(point, bounds), distance, novel: true };
      }
    }

    if (best) {
      return {
        point: best.point,
        cell: best.cell,
        distance: best.distance,
        reason: 'fallback: densest farthest safe point',
      };
    }

    // Last resort: farthest in-bounds corner from current perch — never sticky center.
    const corners: Point[] = [
      { x: bounds.minX, y: bounds.minY },
      { x: bounds.maxX, y: bounds.minY },
      { x: bounds.minX, y: bounds.maxY },
      { x: bounds.maxX, y: bounds.maxY },
    ];
    let corner = corners[0]!;
    let cornerDist = -1;
    for (const c of corners) {
      const d = dist(from, c);
      if (d > cornerDist) {
        cornerDist = d;
        corner = c;
      }
    }
    return {
      point: corner,
      cell: cellOf(corner, bounds),
      distance: cornerDist,
      reason: 'fallback: farthest hero corner',
    };
  };

  const clampPoint = (hero: HTMLElement, p: Point, size: number): Point => {
    const { minX, minY, maxX, maxY } = heroBounds(hero, size);
    return { x: clamp(p.x, minX, maxX), y: clamp(p.y, minY, maxY) };
  };

  /** Catmull-Rom interpolate between p1→p2 with neighbors p0, p3. */
  const catmullRom = (p0: Point, p1: Point, p2: Point, p3: Point, t: number): Point => {
    const t2 = t * t;
    const t3 = t2 * t;
    return {
      x:
        0.5 *
        (2 * p1.x +
          (-p0.x + p2.x) * t +
          (2 * p0.x - 5 * p1.x + 4 * p2.x - p3.x) * t2 +
          (-p0.x + 3 * p1.x - 3 * p2.x + p3.x) * t3),
      y:
        0.5 *
        (2 * p1.y +
          (-p0.y + p2.y) * t +
          (2 * p0.y - 5 * p1.y + 4 * p2.y - p3.y) * t2 +
          (-p0.y + 3 * p1.y - 3 * p2.y + p3.y) * t3),
    };
  };

  const buildWaypoints = (
    hero: HTMLElement,
    from: Point,
    to: Point,
    size: number,
  ): Point[] => {
    const dx = to.x - from.x;
    const dy = to.y - from.y;
    const length = Math.max(1, Math.hypot(dx, dy));
    const ux = dx / length;
    const uy = dy / length;
    const px = -uy;
    const py = ux;

    const count = 6 + Math.floor(Math.random() * 5); // 6–10
    const points: Point[] = [from];

    const lift = clamp(28 + Math.random() * 36, 24, 70);
    points.push(
      clampPoint(
        hero,
        {
          x: from.x + ux * length * rand(0.04, 0.1) + px * rand(-12, 12),
          y: from.y - lift,
        },
        size,
      ),
    );

    const flutterCount = Math.max(3, count - 3);

    let side = Math.random() < 0.5 ? 1 : -1;
    const bigArcSlots = new Set<number>();
    bigArcSlots.add(1 + Math.floor(Math.random() * Math.max(1, flutterCount - 1)));
    if (flutterCount > 4 && Math.random() < 0.85) {
      let second = 1 + Math.floor(Math.random() * Math.max(1, flutterCount - 1));
      while (second === [...bigArcSlots][0] && flutterCount > 2) {
        second = 1 + Math.floor(Math.random() * Math.max(1, flutterCount - 1));
      }
      bigArcSlots.add(second);
    }

    for (let i = 1; i <= flutterCount; i++) {
      const t = i / (flutterCount + 1);
      const along = length * clamp(t + rand(-0.04, 0.04), 0.08, 0.92);
      const baseX = from.x + ux * along;
      const baseY = from.y + uy * along;

      const isBig = bigArcSlots.has(i);
      const amp = isBig ? rand(48, 92) : rand(14, 38);
      const vert = isBig ? rand(-36, 28) : rand(-22, 26);
      if (Math.random() > 0.18) side *= -1;

      points.push(
        clampPoint(
          hero,
          {
            x: baseX + px * side * amp + rand(-10, 10),
            y: baseY + py * side * amp * 0.55 + vert + rand(-8, 8),
          },
          size,
        ),
      );
    }

    const overshoot = rand(18, 42);
    const circleSide = Math.random() < 0.5 ? 1 : -1;
    points.push(
      clampPoint(
        hero,
        {
          x: to.x + ux * overshoot + px * circleSide * rand(16, 36),
          y: to.y + uy * overshoot * 0.35 + rand(-14, 10),
        },
        size,
      ),
    );
    if (Math.random() < 0.65) {
      points.push(
        clampPoint(
          hero,
          {
            x: to.x + px * -circleSide * rand(10, 28),
            y: to.y - rand(6, 20),
          },
          size,
        ),
      );
    }

    points.push(to);
    return points;
  };

  /** Densely sample a smooth path through waypoints; return points + cumulative length. */
  const samplePath = (waypoints: Point[]) => {
    if (waypoints.length < 2) {
      return { samples: waypoints.slice(), cumulative: [0], totalLength: 0 };
    }

    const extended = [
      waypoints[0]!,
      ...waypoints,
      waypoints[waypoints.length - 1]!,
    ];

    const samples: Point[] = [];
    const stepsPerSegment = 10;

    for (let i = 1; i < extended.length - 2; i++) {
      const p0 = extended[i - 1]!;
      const p1 = extended[i]!;
      const p2 = extended[i + 1]!;
      const p3 = extended[i + 2]!;
      for (let s = 0; s < stepsPerSegment; s++) {
        const t = s / stepsPerSegment;
        samples.push(catmullRom(p0, p1, p2, p3, t));
      }
    }
    samples.push(waypoints[waypoints.length - 1]!);

    const cumulative: number[] = [0];
    let total = 0;
    for (let i = 1; i < samples.length; i++) {
      total += dist(samples[i - 1]!, samples[i]!);
      cumulative.push(total);
    }

    return { samples, cumulative, totalLength: total };
  };

  const pointAtLength = (
    samples: Point[],
    cumulative: number[],
    totalLength: number,
    target: number,
  ): Point => {
    if (samples.length === 0) return { x: 0, y: 0 };
    if (target <= 0) return samples[0]!;
    if (target >= totalLength) return samples[samples.length - 1]!;

    let lo = 0;
    let hi = cumulative.length - 1;
    while (lo < hi) {
      const mid = Math.floor((lo + hi) / 2);
      if (cumulative[mid]! < target) lo = mid + 1;
      else hi = mid;
    }
    const i = Math.max(1, lo);
    const a = samples[i - 1]!;
    const b = samples[i]!;
    const ca = cumulative[i - 1]!;
    const cb = cumulative[i]!;
    const seg = Math.max(1e-6, cb - ca);
    const t = (target - ca) / seg;
    return { x: lerp(a.x, b.x, t), y: lerp(a.y, b.y, t) };
  };

  /**
   * Map linear time → distance along path with variable speed:
   * quicker in open mid-flight, slower near turns (path curvature proxy) and landing.
   */
  const distanceForTime = (u: number, totalLength: number) => {
    // Piecewise ease: soft takeoff, freer middle, decelerate into landing
    let shaped: number;
    if (u < 0.18) {
      const t = u / 0.18;
      shaped = 0.14 * (t * t);
    } else if (u < 0.78) {
      const t = (u - 0.18) / 0.6;
      shaped = 0.14 + 0.62 * (0.15 * t + 0.85 * t * t * (3 - 2 * t));
    } else {
      const t = (u - 0.78) / 0.22;
      // Ease-out into perch
      shaped = 0.76 + 0.24 * (1 - Math.pow(1 - t, 2.4));
    }
    return shaped * totalLength;
  };

  /**
   * `position: absolute; left:0; top:0` inside the hero — translate X/Y are hero-local.
   */
  const writeTransform = (el: HTMLElement, point: Point, angle = 0) => {
    el.style.transform = `translate3d(${point.x}px, ${point.y}px, 0) rotate(${angle}deg)`;
  };

  for (const host of hosts) {
    if (!(host instanceof HTMLElement)) continue;

    const hero =
      host.closest<HTMLElement>('[data-butterfly-hero]') ??
      host.closest<HTMLElement>('.home-landing');
    if (!hero) continue;

    const abort = new AbortController();
    const { signal } = abort;

    /** Settled top-left in hero-local coordinates. */
    let position: Point = { x: EDGE + 24, y: EDGE + 96 };
    let angle = 0;
    let flying = false;
    let heroVisible = true;
    let rafId = 0;
    let settleTimer = 0;
    let rearmTimer = 0;
    const recentCells: string[] = [];

    let armed = true;
    let pointerIsAway = true;
    let landTime = 0;
    let lastPointer: Point = { x: -9999, y: -9999 };

    const canvas = host.querySelector('[data-butterfly-rive]');
    let riveInstance: Rive | null = null;
    let riveReady = false;
    let stateMachineName = RIVE_STATE_MACHINE_PREFERRED;
    let isFlyingInput: StateMachineInput | null = null;
    let wingAdjustInput: StateMachineInput | null = null;
    let wingAdjustTimer = 0;
    let riveLoadTimer = 0;
    let foundReport: Record<string, unknown> | null = null;
    let resizeObserver: ResizeObserver | null = null;
    const fallbackEl = host.querySelector('[data-butterfly-fallback]');

    const setInteractive = (on: boolean) => {
      host.style.pointerEvents = on ? 'auto' : 'none';
      host.classList.toggle('is-inert', !on);
    };

    const logState = (label: string, extra: Record<string, unknown> = {}) => {
      devLog(label, {
        heroVisible,
        flying,
        armed,
        pointerIsAway,
        riveReady,
        ...extra,
      });
    };

    const clearWingAdjust = () => {
      if (wingAdjustTimer) window.clearTimeout(wingAdjustTimer);
      wingAdjustTimer = 0;
    };

    const clearRiveLoadTimer = () => {
      if (riveLoadTimer) window.clearTimeout(riveLoadTimer);
      riveLoadTimer = 0;
    };

    const clearFlightTimers = () => {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = 0;
      if (settleTimer) window.clearTimeout(settleTimer);
      settleTimer = 0;
      if (rearmTimer) window.clearTimeout(rearmTimer);
      rearmTimer = 0;
      clearWingAdjust();
      clearRiveLoadTimer();
    };

    const setIsFlying = (value: boolean) => {
      if (isFlyingInput) isFlyingInput.value = value;
    };

    const scheduleWingAdjust = () => {
      clearWingAdjust();
      if (
        !riveReady ||
        !wingAdjustInput ||
        reduceMotion.matches ||
        flying ||
        !heroVisible
      ) {
        return;
      }
      wingAdjustTimer = window.setTimeout(() => {
        wingAdjustTimer = 0;
        if (
          riveReady &&
          wingAdjustInput &&
          !flying &&
          heroVisible &&
          !reduceMotion.matches
        ) {
          wingAdjustInput.fire();
          devLog('wingAdjust fired');
        }
        scheduleWingAdjust();
      }, rand(WING_ADJUST_MIN_MS, WING_ADJUST_MAX_MS));
    };

    const markHeroReady = () => {
      if (hero.hasAttribute('data-await-butterfly')) {
        hero.setAttribute('data-butterfly-ready', '');
      }
    };

    const showFallback = (reason: string) => {
      if (host.classList.contains('is-rive-fallback')) return;
      clearRiveLoadTimer();
      riveReady = false;
      host.classList.remove('is-rive-ready');
      host.classList.add('is-rive-fallback');
      if (fallbackEl instanceof HTMLElement) {
        fallbackEl.hidden = false;
      }
      setIsFlying(false);
      clearWingAdjust();
      if (riveInstance) {
        try {
          riveInstance.cleanup();
        } catch {
          /* ignore */
        }
        riveInstance = null;
      }
      isFlyingInput = null;
      wingAdjustInput = null;
      markHeroReady();
      console.warn('[butterfly] Rive unavailable — using PNG fallback:', reason);
    };

    const resizeRive = () => {
      if (!riveInstance) return;
      try {
        riveInstance.resizeDrawingSurfaceToCanvas();
      } catch {
        /* ignore */
      }
    };

    const logRiveSurface = (label: string) => {
      if (!(canvas instanceof HTMLCanvasElement)) return;
      const css = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      console.info('[butterfly] surface', label, {
        cssWidth: Math.round(css.width),
        cssHeight: Math.round(css.height),
        bufferWidth: canvas.width,
        bufferHeight: canvas.height,
        devicePixelRatio: dpr,
        bufferMatchesDpr:
          canvas.width >= Math.round(css.width * dpr) - 1 &&
          canvas.height >= Math.round(css.height * dpr) - 1,
      });
    };

    const revealRive = () => {
      clearRiveLoadTimer();
      riveReady = true;
      host.classList.remove('is-rive-fallback');
      if (fallbackEl instanceof HTMLElement) {
        fallbackEl.hidden = true;
      }
      // Resize before reveal so the first painted frame is sharp.
      resizeRive();
      requestAnimationFrame(() => {
        resizeRive();
        logRiveSurface('ready');
        host.classList.add('is-rive-ready');
        // Reveal hero + butterfly in the same frame so they appear together.
        markHeroReady();
        setIsFlying(false);
        if (reduceMotion.matches) {
          clearWingAdjust();
        } else {
          scheduleWingAdjust();
        }
      });
    };

    const bindRiveInputs = () => {
      if (!riveInstance) {
        showFallback('instance missing after load');
        return;
      }

      // First resize as soon as Rive has loaded, while canvas is still invisible.
      resizeRive();

      const names = riveInstance.stateMachineNames ?? [];
      if (names.includes(RIVE_STATE_MACHINE_PREFERRED)) {
        stateMachineName = RIVE_STATE_MACHINE_PREFERRED;
      } else if (names.includes(RIVE_STATE_MACHINE_FALLBACK)) {
        stateMachineName = RIVE_STATE_MACHINE_FALLBACK;
      } else if (names.length > 0) {
        stateMachineName = names[0]!;
      }

      const inputs = riveInstance.stateMachineInputs(stateMachineName) ?? [];
      isFlyingInput = inputs.find((input) => input.name === RIVE_INPUT_FLYING) ?? null;
      wingAdjustInput =
        inputs.find((input) => input.name === RIVE_INPUT_WING_ADJUST) ?? null;

      foundReport = {
        artboard: RIVE_ARTBOARD,
        stateMachines: names,
        activeStateMachine: stateMachineName,
        preferredStateMachinePresent: names.includes(RIVE_STATE_MACHINE_PREFERRED),
        inputs: inputs.map((input) => input.name),
        isFlying: Boolean(isFlyingInput),
        wingAdjust: Boolean(wingAdjustInput),
      };
      devLog('rive bound', foundReport);

      if (!isFlyingInput) {
        console.warn('[butterfly] isFlying input not found on', stateMachineName);
      }
      if (!wingAdjustInput) {
        console.warn('[butterfly] wingAdjust input not found on', stateMachineName);
      }

      revealRive();
    };

    const startRiveWithStateMachine = (smName: string, allowFallback: boolean) => {
      if (!(canvas instanceof HTMLCanvasElement)) {
        showFallback('missing canvas');
        return;
      }

      try {
        riveInstance = new Rive({
          src: RIVE_SRC,
          canvas,
          artboard: RIVE_ARTBOARD,
          stateMachines: smName,
          autoplay: true,
          layout: new Layout({
            fit: Fit.Contain,
            alignment: Alignment.Center,
          }),
          onLoad: () => {
            stateMachineName = smName;
            bindRiveInputs();
          },
          onLoadError: (error) => {
            if (allowFallback && smName === RIVE_STATE_MACHINE_PREFERRED) {
              devLog('preferred state machine failed; trying V2', String(error));
              try {
                riveInstance?.cleanup();
              } catch {
                /* ignore */
              }
              riveInstance = null;
              startRiveWithStateMachine(RIVE_STATE_MACHINE_FALLBACK, false);
              return;
            }
            showFallback(`load failed (${smName}): ${String(error)}`);
          },
        });
      } catch (error) {
        if (allowFallback && smName === RIVE_STATE_MACHINE_PREFERRED) {
          startRiveWithStateMachine(RIVE_STATE_MACHINE_FALLBACK, false);
          return;
        }
        showFallback(`init threw: ${String(error)}`);
      }
    };

    const initRive = () => {
      if (!(canvas instanceof HTMLCanvasElement)) {
        showFallback('missing canvas');
        return;
      }

      // Leave canvas CSS at 100%/100%; resizeDrawingSurfaceToCanvas sets the
      // DPR-scaled backing buffer after load — do not assign 1× width/height here.

      clearRiveLoadTimer();
      riveLoadTimer = window.setTimeout(() => {
        riveLoadTimer = 0;
        if (!riveReady) {
          showFallback(`load timed out after ${RIVE_LOAD_TIMEOUT_MS}ms`);
        }
      }, RIVE_LOAD_TIMEOUT_MS);

      // Asset embeds "Butterfly Controller V2" (not the unversioned preferred name).
      startRiveWithStateMachine(RIVE_STATE_MACHINE_FALLBACK, false);
    };

    const applyReduced = () => {
      host.classList.toggle('is-reduced', reduceMotion.matches);
      if (reduceMotion.matches) {
        host.classList.remove('is-flying', 'is-settling');
        clearFlightTimers();
        flying = false;
        armed = false;
        setIsFlying(false);
        clearWingAdjust();
        setInteractive(false);
      } else if (heroVisible) {
        setInteractive(true);
        if (!flying && riveReady) scheduleWingAdjust();
      }
    };

    const rememberCell = (point: Point) => {
      const key = cellOf(point, heroBounds(hero, sizeOf(host))).key;
      recentCells.push(key);
      while (recentCells.length > 5) recentCells.shift();
      return key;
    };

    /** Measure painted top-left in hero-local space (level pose only). */
    const readLocalTopLeft = (): Point => {
      const hr = hero.getBoundingClientRect();
      const r = host.getBoundingClientRect();
      return { x: r.left - hr.left, y: r.top - hr.top };
    };

    const commitSettled = (point: Point, nextAngle = 0) => {
      host.style.transform = '';
      const bounds = heroBounds(hero, sizeOf(host));
      const clamped = {
        x: clamp(point.x, bounds.minX, bounds.maxX),
        y: clamp(point.y, bounds.minY, bounds.maxY),
      };
      writeTransform(host, clamped, nextAngle);
      if (nextAngle === 0) {
        const measured = readLocalTopLeft();
        writeTransform(host, measured, 0);
        position = measured;
      } else {
        position = clamped;
      }
      angle = nextAngle;
      return { ...position };
    };

    const pointerDistance = (clientX: number, clientY: number) => {
      const r = host.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      return Math.hypot(clientX - cx, clientY - cy);
    };

    const nearButterfly = (clientX: number, clientY: number) => {
      const r = host.getBoundingClientRect();
      const radius = Math.max(r.width, r.height) / 2 + PROXIMITY;
      return pointerDistance(clientX, clientY) <= radius;
    };

    const rearm = (via: 'automatic' | 'pointermove') => {
      if (armed || flying || !heroVisible || reduceMotion.matches) return;
      armed = true;
      pointerIsAway = true;
      setInteractive(true);
      logState('rearmed', {
        via,
        pointerDistance: pointerDistance(lastPointer.x, lastPointer.y),
      });
    };

    const tryRearmFromPointer = (clientX: number, clientY: number) => {
      if (armed || flying || !heroVisible) return;
      const distance = pointerDistance(clientX, clientY);
      const away = distance >= REARM_DISTANCE;
      if (away) pointerIsAway = true;
      const cooled = performance.now() - landTime >= LANDING_COOLDOWN_MS;
      if (away && cooled) rearm('pointermove');
    };

    /** After cooldown, auto-rearm if the butterfly already left the pointer behind. */
    const scheduleRearmCheck = () => {
      if (rearmTimer) window.clearTimeout(rearmTimer);
      rearmTimer = window.setTimeout(() => {
        rearmTimer = 0;
        if (armed || flying || !heroVisible) return;
        const distance = pointerDistance(lastPointer.x, lastPointer.y);
        logState('rearm cooldown elapsed', { pointerDistance: distance });
        if (distance >= REARM_DISTANCE) {
          rearm('automatic');
        }
      }, LANDING_COOLDOWN_MS);
    };

    const disarmAfterLanding = (pointerDistAtLand: number) => {
      armed = false;
      pointerIsAway = pointerDistAtLand >= REARM_DISTANCE;
      landTime = performance.now();
      setInteractive(true); // keep hit-testing available once rearmed; never leave none stuck
      logState('disarmed after landing', { pointerDistance: pointerDistAtLand });
      scheduleRearmCheck();
    };

    const initialPlace = () => {
      const size = sizeOf(host);
      const bounds = heroBounds(hero, size);
      let next: Point = {
        x: clamp(hero.clientWidth * 0.08 - size / 2, bounds.minX, bounds.maxX),
        y: clamp(hero.clientHeight * 0.2 - size / 2, bounds.minY, bounds.maxY),
      };

      const logo = hero.querySelector('.home-landing__logo');
      if (logo instanceof Element) {
        const hr = hero.getBoundingClientRect();
        const lr = logo.getBoundingClientRect();
        const localLogo = {
          left: lr.left - hr.left,
          right: lr.right - hr.left,
          top: lr.top - hr.top,
          bottom: lr.bottom - hr.top,
        };
        const box = new DOMRect(next.x, next.y, size, size);
        const logoBox = new DOMRect(
          localLogo.left,
          localLogo.top,
          localLogo.right - localLogo.left,
          localLogo.bottom - localLogo.top,
        );
        if (rectsOverlap(box, logoBox, 8)) {
          next.y = clamp(localLogo.bottom + 12, bounds.minY, bounds.maxY);
        }
      }

      commitSettled(next, -6);
      rememberCell(position);
      armed = true;
      pointerIsAway = true;
      setInteractive(true);
    };

    const finishLanding = (to: Point) => {
      const settled = commitSettled(to, 0);
      rememberCell(settled);
      host.classList.remove('is-flying', 'is-settling');
      const pointerDistAtLand = pointerDistance(lastPointer.x, lastPointer.y);
      flying = false;
      // Blend back to Idle only after the settled transform is committed.
      setIsFlying(false);
      setInteractive(true);
      disarmAfterLanding(pointerDistAtLand);
      if (heroVisible && !reduceMotion.matches) scheduleWingAdjust();
      logState('landing committed', {
        position: settled,
        cell: cellOf(settled, heroBounds(hero, sizeOf(host))).key,
        pointerDistance: pointerDistAtLand,
      });
    };

    const fly = () => {
      if (flying || reduceMotion.matches || !armed || !heroVisible) return;

      const size = sizeOf(host);
      const from = commitSettled({ ...position }, 0);
      let pick = pickDestination(hero, from, size, recentCells);
      // If sampling collapsed near the perch, retry once ignoring cell history.
      if (pick.distance < MIN_TRAVEL_FLOOR * 0.75) {
        pick = pickDestination(hero, from, size, []);
      }
      const to = pick.point;

      if (pick.distance < 48) {
        devLog('abort flight — no meaningful destination', pick);
        return;
      }

      logState('flight start', {
        from,
        to: pick.point,
        distance: Math.round(pick.distance),
        gridCell: pick.cell.key,
        reason: pick.reason,
      });

      const waypoints = buildWaypoints(hero, from, to, size);
      const { samples, cumulative, totalLength } = samplePath(waypoints);
      if (totalLength < 8 || samples.length < 2) return;

      const duration = clamp(
        2100 + totalLength * 2.1 + rand(-220, 320),
        FLIGHT_MIN_MS,
        FLIGHT_MAX_MS,
      );
      const settleMs = rand(SETTLE_MS_MIN, SETTLE_MS_MAX);
      const settleAt = duration - settleMs;

      flying = true;
      armed = false;
      clearWingAdjust();
      setIsFlying(true);
      setInteractive(true);
      host.classList.add('is-flying');
      host.classList.remove('is-settling');

      const startAngle = angle;
      let prev = from;
      let smoothedAngle = startAngle;
      let settling = false;
      const t0 = performance.now();

      const tick = (now: number) => {
        const elapsed = now - t0;
        const u = clamp(elapsed / duration, 0, 1);
        const along = distanceForTime(u, totalLength);
        const point = pointAtLength(samples, cumulative, totalLength, along);

        const vx = point.x - prev.x;
        const vy = point.y - prev.y;
        const speed = Math.hypot(vx, vy);

        if (speed > 0.05) {
          const headingDeg = (Math.atan2(vy, vx) * 180) / Math.PI;
          const targetTilt = clamp((headingDeg / 90) * MAX_TILT, -MAX_TILT, MAX_TILT);
          const blend = u > 0.88 ? 0.12 : 0.18;
          smoothedAngle = lerp(smoothedAngle, targetTilt, blend);
        }

        if (u > 0.9) {
          const landT = (u - 0.9) / 0.1;
          smoothedAngle = lerp(smoothedAngle, 0, landT * landT);
        }

        writeTransform(host, point, smoothedAngle);
        prev = point;
        angle = smoothedAngle;

        if (!settling && elapsed >= settleAt) {
          settling = true;
          host.classList.add('is-settling');
        }

        if (u < 1) {
          rafId = requestAnimationFrame(tick);
          return;
        }

        rafId = 0;
        writeTransform(host, to, 0);
        host.classList.add('is-settling');
        if (settleTimer) window.clearTimeout(settleTimer);
        settleTimer = window.setTimeout(() => {
          settleTimer = 0;
          finishLanding(to);
        }, Math.min(180, settleMs * 0.35));
      };

      rafId = requestAnimationFrame(tick);
    };

    const onPointerActivity = (clientX: number, clientY: number, isEnter: boolean) => {
      lastPointer = { x: clientX, y: clientY };
      if (flying || reduceMotion.matches || !heroVisible) return;

      if (!armed) {
        tryRearmFromPointer(clientX, clientY);
        return;
      }

      const near = nearButterfly(clientX, clientY);
      if (!near) {
        pointerIsAway = true;
        return;
      }

      if (pointerIsAway || isEnter) {
        pointerIsAway = false;
        fly();
      }
    };

    host.addEventListener(
      'pointerenter',
      (event) => onPointerActivity(event.clientX, event.clientY, true),
      { signal },
    );

    // Document-level moves: rearm even when the pointer never re-enters the butterfly
    window.addEventListener(
      'pointermove',
      (event) => onPointerActivity(event.clientX, event.clientY, false),
      { signal, passive: true },
    );

    window.addEventListener(
      'resize',
      () => {
        const bounds = heroBounds(hero, sizeOf(host));
        const next = {
          x: clamp(position.x, bounds.minX, bounds.maxX),
          y: clamp(position.y, bounds.minY, bounds.maxY),
        };
        if (!flying) commitSettled(next, angle);
        resizeRive();
      },
      { signal, passive: true },
    );

    if (typeof ResizeObserver !== 'undefined') {
      resizeObserver = new ResizeObserver(() => {
        resizeRive();
      });
      resizeObserver.observe(host);
      if (canvas instanceof HTMLCanvasElement) {
        resizeObserver.observe(canvas);
      }
    }

    const visibility = new IntersectionObserver(
      ([entry]) => {
        heroVisible = Boolean(entry?.isIntersecting);
        logState('hero visibility', { ratio: entry?.intersectionRatio ?? 0 });
        if (!heroVisible) {
          // Disable interaction while scrolled away; do not cancel an in-flight animation mid-air
          clearWingAdjust();
          if (!flying) {
            armed = false;
            setInteractive(false);
          }
        } else if (!flying && !reduceMotion.matches) {
          setInteractive(true);
          // Re-evaluate rearm against last known pointer now that hero is back
          scheduleRearmCheck();
          scheduleWingAdjust();
        }
      },
      { threshold: 0.05 },
    );
    visibility.observe(hero);

    reduceMotion.addEventListener(
      'change',
      () => {
        applyReduced();
      },
      { signal },
    );

    const cleanup = () => {
      clearFlightTimers();
      setIsFlying(false);
      if (resizeObserver) {
        resizeObserver.disconnect();
        resizeObserver = null;
      }
      if (riveInstance) {
        try {
          riveInstance.cleanup();
        } catch {
          /* ignore */
        }
        riveInstance = null;
      }
      visibility.disconnect();
      abort.abort();
      watcher.disconnect();
    };

    const watcher = new MutationObserver(() => {
      if (!document.contains(host)) cleanup();
    });
    watcher.observe(document.documentElement, { childList: true, subtree: true });
    window.addEventListener('pagehide', cleanup, { signal });

    applyReduced();
    initialPlace();
    initRive();
  }
</script>
