---
import { siteConfig } from '../config/site';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const carriers = siteConfig.insurance.featuredCarrierLogos;
---

{
  carriers.length > 0 ? (
    <ul class:list={['insurance-carriers__row', className]} role="list">
      {carriers.map((carrier) => (
        <li class="insurance-carriers__row-item">
          {carrier.id === 'blue-cross-blue-shield' ? (
            <span class="insurance-carriers__bcbs" role="img" aria-label="Blue Cross Blue Shield">
              <span class="insurance-carriers__bcbs-main">
                <svg
                  class="insurance-carriers__bcbs-icons"
                  viewBox="0 0 54 28"
                  aria-hidden="true"
                  focusable="false"
                >
                  <rect x="0" y="10" width="22" height="7" rx="1" fill="currentColor" />
                  <rect x="7.5" y="3" width="7" height="21" rx="1" fill="currentColor" />
                  <path
                    d="M35 2.5c4.5 1.5 7.5 2 10 2v9.5c0 3.7-2.6 6.6-10 9.8C27.5 20.6 25 17.7 25 14V4.5c2.5 0 5.5-.5 10-2z"
                    fill="currentColor"
                  />
                </svg>
                <span class="insurance-carriers__bcbs-wordmark">
                  <span>BlueCross</span>
                  <span>BlueShield</span>
                </span>
              </span>
              <span class="insurance-carriers__bcbs-disclaimer">Check local plan for coverage</span>
            </span>
          ) : carrier.id === 'anthem' ? (
            <span class="insurance-carriers__anthem" role="img" aria-label="Anthem">
              <span class="insurance-carriers__anthem-word">Anthem</span>
              <svg
                class="insurance-carriers__bcbs-icons"
                viewBox="0 0 54 28"
                aria-hidden="true"
                focusable="false"
              >
                <rect x="0" y="10" width="22" height="7" rx="1" fill="currentColor" />
                <rect x="7.5" y="3" width="7" height="21" rx="1" fill="currentColor" />
                <path
                  d="M35 2.5c4.5 1.5 7.5 2 10 2v9.5c0 3.7-2.6 6.6-10 9.8C27.5 20.6 25 17.7 25 14V4.5c2.5 0 5.5-.5 10-2z"
                  fill="currentColor"
                />
              </svg>
            </span>
          ) : (
            <img
              src={'logo' in carrier ? carrier.logo : ''}
              alt={`${carrier.name} logo`}
              class:list={[
                'insurance-carriers__row-logo',
                carrier.id === 'unitedhealthcare' ? 'insurance-carriers__row-logo--uhc' : '',
                carrier.id === 'carelon' ? 'insurance-carriers__row-logo--carelon' : '',
                carrier.id === 'cigna' ? 'insurance-carriers__row-logo--cigna' : '',
              ]}
              width={160}
              height={48}
              loading="lazy"
              decoding="async"
            />
          )}
        </li>
      ))}
    </ul>
  ) : null
}
