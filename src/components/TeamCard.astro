---
interface Props {
  name: string;
  title: string;
  subtitle?: string;
  bio: string;
}

const { name, title, subtitle, bio } = Astro.props;
---

<article class="card flex flex-col overflow-hidden sm:flex-row">
  <div class="flex h-48 w-full shrink-0 items-center justify-center bg-gradient-to-br from-sage-light to-sage sm:h-auto sm:w-48">
    <div class="flex h-24 w-24 items-center justify-center rounded-full bg-cream/80 font-serif text-3xl text-sage-dark">
      {name.charAt(0)}
    </div>
  </div>
  <div class="flex flex-col justify-center p-6 sm:p-8">
    <h3 class="font-serif text-2xl">{name}</h3>
    <p class="mt-1 text-sm font-semibold text-sage-dark">{title}</p>
    {subtitle && <p class="mt-1 text-sm text-sage-dark/70">{subtitle}</p>}
    <p class="prose-content mt-4 text-sm">{bio}</p>
  </div>
</article>
