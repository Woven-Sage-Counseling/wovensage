---
import BookingButton from './BookingButton.astro';
import { siteConfig } from '../config/site';

const trustIndicators = [
  'Licensed Florida clinicians',
  'Secure telehealth',
  'In-person care in South Florida',
  'Inclusive, affirming care',
] as const;
---

<div class="mt-8 flex flex-col items-center sm:mt-10">
  <div class="flex flex-wrap justify-center gap-4">
    <BookingButton />
    <a href="/about" class="btn-secondary">Learn about us</a>
  </div>

  <ul class="mt-6 flex max-w-xl flex-wrap justify-center gap-2 sm:mt-7 sm:gap-2.5" aria-label="Practice highlights">
    {
      trustIndicators.map((item) => (
        <li>
          <span class="inline-block rounded-full border border-sage/20 bg-cream/70 px-3 py-1 text-[0.6875rem] font-medium tracking-wide text-sage-dark/75 backdrop-blur-sm sm:text-xs">
            {item}
          </span>
        </li>
      ))
    }
  </ul>

  <p class="mt-5 max-w-md text-center text-sm leading-relaxed text-sage-dark/60">
    {siteConfig.bookingTrustCopy}
  </p>
</div>
