---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedCarrierLogos from '../components/FeaturedCarrierLogos.astro';
import Logo from '../components/Logo.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title={siteConfig.name}
  description="Whatever brought you here — we're glad you made it. Woven Sage Counseling provides therapy in South Florida in person and via secure telehealth throughout Florida."
  botanicalBg={false}
  hideHeader
>
  <!--
    Poster hero: the full reference plate + copy live in a fixed 16:9 frame.
    The frame scales as one unit (no object-fit cover crop), so art never drifts on resize.
  -->
  <section class="home-landing" aria-labelledby="home-landing-heading">
    <div class="home-landing__poster">
      <img
        src={siteConfig.logos.homeHeroPlate}
        alt=""
        width={1024}
        height={576}
        class="home-landing__plate"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />

      <a href="/" class="home-landing__brand" aria-label={siteConfig.name}>
        <Logo variant="text" class="brightness-0 invert" />
      </a>

      <div class="home-landing__copy">
        <h1 id="home-landing-heading" class="home-landing__title">
          Whatever brought you here…
          <span class="home-landing__title-line">we&apos;re glad you made it.</span>
        </h1>

        <p class="home-landing__sub">
          A space to feel understood. Support for what comes next.
        </p>

        <div class="home-landing__actions">
          <a href={siteConfig.bookingUrl} class="home-landing__cta">
            Find your therapist
            <span aria-hidden="true">↗</span>
          </a>
          <p class="home-landing__consult">Complimentary 15-minute consultation</p>
        </div>
      </div>

      <p class="home-landing__trust">
        Florida-based · Secure telehealth · Inclusive &amp; affirming
      </p>
    </div>
  </section>

  <section
    id="coverage"
    class="border-t border-sage-dark/10 bg-cream px-5 py-16 sm:px-8 sm:py-20"
    aria-labelledby="coverage-teaser-heading"
  >
    <div class="container-page mx-auto max-w-4xl text-center">
      <h2
        id="coverage-teaser-heading"
        class="font-display text-[1.65rem] font-normal tracking-tight text-sage-dark sm:text-[2rem]"
      >
        We work with major insurers
      </h2>

      <FeaturedCarrierLogos class="mt-10 sm:mt-12" />

      <div class="mt-10 sm:mt-12">
        <a href="/coverage" class="btn-primary inline-flex gap-2">
          See if you&apos;re covered today
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
