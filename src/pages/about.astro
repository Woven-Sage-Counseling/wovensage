---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
const beliefPairs = [
  { less: 'Less fixing...', more: 'More understanding.' },
  { less: 'Less judgment...', more: 'More curiosity.' },
  { less: 'Less assumptions...', more: 'More listening.' },
  { less: 'Less pressure...', more: 'More room to breathe.' },
] as const;

const promises = [
  {
    title: "We'll meet you where you are.",
    detail: 'You don’t have to have it all figured out.\nHowever you arrive is enough.',
  },
  {
    title: "We'll move at your pace.",
    detail: 'There’s no timeline you have to keep up with.\nYour progress is yours alone.',
  },
  {
    title: "We'll listen before we lead.",
    detail:
      'Understanding comes first. Guidance only follows once you’ve been fully heard.',
  },
  {
    title: "We'll make space for every part of your story.",
    detail: 'The messy parts.\nThe uncertain parts.\nThe parts you’ve never said out loud.',
  },
] as const;
---

<BaseLayout
  title="Why Woven Sage"
  description="Why Woven Sage Counseling exists — and what makes therapy here feel different. An editorial reflection on connection, clarity, and care in South Florida."
  botanicalBg={false}
>
  <article class="why-page">
    <!-- Hero -->
    <section class="why-hero relative overflow-hidden bg-cream" aria-labelledby="why-hero-heading">
      <div class="hero-breathe pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="why-hero__grain pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <div
        class="why-hero__botanical pointer-events-none absolute bottom-0 left-0 z-0 select-none"
        aria-hidden="true"
      >
        <img
          src={siteConfig.logos.sageBotanicalHero}
          alt=""
          width={682}
          height={1024}
          class="why-hero__botanical-img sage-enter block h-auto w-auto max-w-none"
          loading="eager"
          decoding="async"
        />
      </div>

      <p class="scroll-reveal why-kicker why-hero__kicker">Why Woven Sage</p>

      <div class="container-page relative z-10">
        <div class="why-hero__inner mx-auto max-w-2xl text-center">
          <h1
            id="why-hero-heading"
            class="scroll-reveal font-display text-[2.385rem] font-normal leading-[1.14] tracking-tight text-[#2E2D2A] sm:text-[3.18rem] md:text-[3.71rem]"
          >
            Therapy should feel <em class="italic text-sage">different</em>.
          </h1>

          <div class="scroll-reveal scroll-reveal--delay-1 why-hero__copy mx-auto mt-12 max-w-xl sm:mt-14 md:mt-16">
            <p>
              Different doesn&apos;t mean complicated.
            </p>
            <p>
              <span class="block">It means slowing down.</span>
              <span class="block">Feeling understood before being analyzed.</span>
              <span class="block">Having space to speak before being expected to solve.</span>
            </p>
            <p class="why-hero__copy-close">
              That&apos;s what Woven Sage was built to be.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- What we believe -->
    <section id="why-beliefs" class="why-beliefs" aria-labelledby="why-beliefs-heading">
      <div class="why-beliefs__frame">
        <div class="why-beliefs__media">
          <div id="why-beliefs-parallax" class="why-beliefs__parallax">
            <img
              class="why-beliefs__image"
              src="/images/sage-leaves-beliefs.jpg"
              alt=""
              width={1024}
              height={560}
              loading="eager"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        </div>

        <div class="why-beliefs__content">
          <div class="container-page">
            <div class="why-beliefs__inner mx-auto max-w-xl text-center">
              <h2 id="why-beliefs-heading" class="scroll-reveal why-beliefs__title font-display text-[1.75rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[2.125rem]">
                The way we practice.
              </h2>

              <div class="why-beliefs__list mt-12 sm:mt-14" role="list">
                {
                  beliefPairs.map((pair, index) => (
                    <div
                      class:list={[
                        'why-beliefs__pair scroll-reveal',
                        index > 0 ? 'scroll-reveal--delay-1' : '',
                      ]}
                      role="listitem"
                    >
                      <p class="why-beliefs__less">{pair.less}</p>
                      <p class="why-beliefs__more">{pair.more}</p>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why the name -->
    <section class="why-name why-section why-section--soft bg-cream" aria-labelledby="why-name-heading">
      <div class="container-page">
        <div class="why-name__inner mx-auto max-w-2xl md:max-w-4xl lg:max-w-5xl">
          <h2
            id="why-name-heading"
            class="scroll-reveal why-name__title text-center font-display text-[1.75rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[2.125rem]"
          >
            The name <em class="italic text-sage">Woven Sage</em> reflects the way we think healing happens.
          </h2>

          <p class="scroll-reveal why-name__intro mx-auto mt-10 max-w-xl text-center sm:mt-12">
            Healing isn&apos;t about becoming someone new. It&apos;s about reconnecting with the parts
            of yourself that have always been there, through patience, compassion, and time.
          </p>

          <div class="why-name__parts mt-14 sm:mt-16">
            <div class="scroll-reveal why-name__part why-name__part--woven">
              <p class="why-name__word">Woven</p>
              <p class="why-name__verse">
                Individual threads are fragile.
              </p>
              <p class="why-name__verse">
                But woven together, they become something stronger than any one strand alone.
              </p>
              <p class="why-name__verse">
                Therapy can be like that. Experiences, relationships, grief, resilience, and hope
                don&apos;t exist separately forever. Over time, they begin to connect into a life that
                feels whole again.
              </p>
            </div>

            <div class="why-name__center" aria-hidden="true">
              <img
                class="why-name__emblem"
                src={siteConfig.logos.leaf}
                alt=""
                width={320}
                height={320}
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="scroll-reveal scroll-reveal--delay-1 why-name__part why-name__part--sage">
              <p class="why-name__word">Sage</p>
              <p class="why-name__verse">
                Sage grows quietly.
              </p>
              <p class="why-name__verse">
                It doesn&apos;t rush. It doesn&apos;t demand attention. It simply keeps reaching toward
                what helps it endure.
              </p>
              <p class="why-name__verse">
                That&apos;s the kind of growth we believe in&mdash;not dramatic transformation, but
                steady healing, deeper wisdom, and becoming more yourself over time.
              </p>
            </div>
          </div>

          <div class="scroll-reveal why-name__close-wrap">
            <p class="why-name__close">
              Woven Sage is more than our name. It&apos;s the way we hope every person feels when they
              leave our office:
              <br />
              <strong class="why-name__close-emphasis">a little more whole than when they arrived.</strong>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- What you can expect -->
    <section class="why-promise why-section bg-cream" aria-labelledby="why-promise-heading">
      <div class="container-page">
        <div class="why-promise__inner mx-auto">
          <h2
            id="why-promise-heading"
            class="scroll-reveal why-promise__title text-center font-display text-[1.75rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[2.125rem]"
          >
            What you can expect
          </h2>

          <ul class="why-promise__grid mt-12 sm:mt-14" role="list">
            {
              promises.map((promise, index) => (
                <li class="why-promise__item scroll-reveal">
                  <article class="why-promise__card" tabindex="0">
                    <div class="why-promise__front">
                      <span class="why-promise__number" aria-hidden="true">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <p class="why-promise__text">{promise.title}</p>
                    </div>
                    <p class="why-promise__detail">{promise.detail}</p>
                  </article>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="why-closing relative overflow-hidden bg-cream pb-24 pt-8 sm:pb-32 sm:pt-12" aria-labelledby="why-closing-heading">
      <div class="hero-breathe pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

      <div class="container-page relative z-10">
        <div class="mx-auto max-w-xl text-center">
          <h2 id="why-closing-heading" class="sr-only">Begin with us</h2>

          <p class="scroll-reveal font-display text-[1.35rem] leading-relaxed text-sage-dark/85 sm:text-[1.65rem]">
            The hardest part is deciding to begin.
          </p>

          <p class="scroll-reveal scroll-reveal--delay-1 mt-4 font-display text-[1.35rem] leading-relaxed text-sage-dark/72 sm:mt-5 sm:text-[1.65rem]">
            We&apos;ll help with everything after that.
          </p>

          <div class="scroll-reveal scroll-reveal--delay-2 mt-9 sm:mt-10">
            <a href="/services" class="btn-primary hero-cta why-closing__cta inline-flex">
              Explore Our Services →
            </a>
          </div>
        </div>
      </div>
    </section>
  </article>

  <script>
    import { initScrollReveal } from '../scripts/scroll-reveal';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const whyBeliefs = document.getElementById('why-beliefs');
    const whyBeliefsParallax = document.getElementById('why-beliefs-parallax');

    if (whyBeliefs && whyBeliefsParallax && !reduceMotion) {
      const maxShiftPx = 16;

      const updateWhyBeliefsParallax = () => {
        const rect = whyBeliefs.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        const progress = (viewportHeight - rect.top) / (viewportHeight + rect.height);
        const clamped = Math.min(Math.max(progress, 0), 1);
        const offset = (clamped - 0.5) * maxShiftPx * 2;

        whyBeliefsParallax.style.transform = `translate3d(0, ${offset.toFixed(2)}px, 0)`;
      };

      updateWhyBeliefsParallax();
      window.addEventListener('scroll', updateWhyBeliefsParallax, { passive: true });
      window.addEventListener('resize', updateWhyBeliefsParallax, { passive: true });
    }

    initScrollReveal(reduceMotion);
  </script>
</BaseLayout>
