---
/**
 * Reusable Rive butterfly for the Woven Sage site.
 * Asset: /animations/woven-sage-butterfly.riv
 * Artboard: Butterfly · State machine: Butterfly Controller · Input: isFlying
 */
interface Props {
  class?: string;
  /** Display width in CSS pixels. Height follows the canvas aspect. */
  width?: number;
}

const { class: className = '', width = 120 } = Astro.props;
const height = Math.round(width * 0.75);
---

<div
  class:list={['rive-butterfly', className]}
  data-rive-butterfly
  style={`width: ${width}px; height: ${height}px;`}
  role="img"
  aria-label="Woven Sage butterfly"
>
  <canvas
    class="rive-butterfly__canvas"
    width={width}
    height={height}
    data-rive-butterfly-canvas
  ></canvas>
</div>

<style>
  .rive-butterfly {
    position: fixed;
    left: 1.25rem;
    bottom: 1.25rem;
    z-index: 40;
    pointer-events: none;
    background: transparent;
  }

  .rive-butterfly__canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
  }
</style>

<script>
  import { Rive, Layout, Fit, Alignment } from '@rive-app/webgl2';

  const SRC = '/animations/woven-sage-butterfly.riv';
  const ARTBOARD = 'Butterfly';
  const STATE_MACHINE = 'Butterfly Controller';
  const FLYING_INPUT = 'isFlying';

  const hosts = document.querySelectorAll('[data-rive-butterfly]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const instances: Rive[] = [];

  for (const host of hosts) {
    if (!(host instanceof HTMLElement)) continue;
    const canvas = host.querySelector('[data-rive-butterfly-canvas]');
    if (!(canvas instanceof HTMLCanvasElement)) continue;

    const rive = new Rive({
      src: SRC,
      canvas,
      artboard: ARTBOARD,
      stateMachine: STATE_MACHINE,
      autoplay: true,
      layout: new Layout({
        fit: Fit.Contain,
        alignment: Alignment.Center,
      }),
      onLoad: () => {
        rive.resizeDrawingSurfaceToCanvas();

        const inputs = rive.stateMachineInputs(STATE_MACHINE) ?? [];
        const isFlying = inputs.find((input) => input.name === FLYING_INPUT);
        if (isFlying) {
          isFlying.value = false;
        }

        if (reduceMotion.matches) {
          rive.pause();
        }
      },
      onLoadError: (error) => {
        console.error('Rive butterfly failed to load', error);
      },
    });

    instances.push(rive);
  }

  const onResize = () => {
    for (const rive of instances) {
      rive.resizeDrawingSurfaceToCanvas();
    }
  };
  window.addEventListener('resize', onResize, { passive: true });

  const onMotionChange = () => {
    for (const rive of instances) {
      if (reduceMotion.matches) rive.pause();
      else rive.play();
    }
  };
  reduceMotion.addEventListener('change', onMotionChange);

  const cleanup = () => {
    window.removeEventListener('resize', onResize);
    reduceMotion.removeEventListener('change', onMotionChange);
    for (const rive of instances) {
      rive.cleanup();
    }
    instances.length = 0;
    watcher.disconnect();
  };

  const watcher = new MutationObserver(() => {
    if (![...hosts].some((host) => document.contains(host))) cleanup();
  });
  watcher.observe(document.documentElement, { childList: true, subtree: true });
  window.addEventListener('pagehide', cleanup, { once: true });
</script>
