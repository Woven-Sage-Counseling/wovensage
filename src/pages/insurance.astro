---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const { note, carriers } = siteConfig.insurance;
const featuredOrder = [
  'unitedhealthcare',
  'umr',
  'aetna',
  'cigna',
  'oscar',
] as const;
const featuredCarriers = featuredOrder
  .map((id) => carriers.find((carrier) => carrier.id === id))
  .filter((carrier): carrier is (typeof carriers)[number] => Boolean(carrier));
const searchableCarriers = carriers;

const detailCards = [
  {
    title: 'Private pay',
    body: 'Private pay is available for clients who prefer to pay out of pocket or whose insurance is not in network. Contact us for current session rates and availability.',
  },
  {
    title: 'Payment methods',
    body: 'We accept major credit and debit cards. HSA and FSA cards are typically accepted for eligible mental health services — confirm with your card provider.',
  },
  {
    title: 'Cancellation policy',
    body: 'We ask for at least 24 hours’ notice if you need to cancel or reschedule. Late cancellations and missed appointments may be subject to a fee.',
  },
  {
    title: 'Good faith estimate',
    body: 'If you do not have health insurance or choose not to use it, you have the right under the No Surprises Act to receive a Good Faith Estimate of expected costs. You can request one before scheduling or anytime during care. If your final bill is at least $400 more than the estimate, you may have the right to dispute the charge. Contact us to request an estimate.',
  },
] as const;

const statusLabel = (status: string) => {
  if (status === 'active') return 'Active';
  return 'Coming soon';
};
---

<BaseLayout
  title="Insurance & Fees"
  description="Insurance, private pay, and payment options at Woven Sage Counseling. Search accepted carriers and learn how care can be covered."
  botanicalBg={false}
>
  <article class="insurance-page why-page">
    <!-- Carriers -->
    <section class="why-section why-section--soft bg-cream" aria-labelledby="insurance-carriers-heading">
      <div class="container-page">
        <div class="mx-auto max-w-5xl">
          <h1
            id="insurance-carriers-heading"
            class="scroll-reveal text-center font-display text-[1.75rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[2.125rem]"
          >
            Insurance
          </h1>

          <p class="scroll-reveal scroll-reveal--delay-1 mx-auto mt-6 max-w-2xl text-center text-[1.0625rem] leading-relaxed text-sage-dark/72 sm:mt-8 sm:text-lg">
            {note}
          </p>

          {
            carriers.length === 0 ? (
              <p class="scroll-reveal scroll-reveal--delay-1 mt-10 text-center italic text-sage-dark/65 sm:mt-12">
                Accepted insurance plans will appear here as credentialing is completed.
              </p>
            ) : (
              <div class="insurance-carriers mt-12 sm:mt-14">
                {featuredCarriers.length > 0 && (
                  <ul class="insurance-carriers__row scroll-reveal" role="list">
                    {featuredCarriers.map((carrier) => (
                      <li class="insurance-carriers__row-item">
                        {carrier.logo ? (
                          <img
                            src={carrier.logo}
                            alt={`${carrier.name} logo`}
                            class:list={[
                              'insurance-carriers__row-logo',
                              carrier.id === 'cigna'
                                ? 'insurance-carriers__row-logo--cigna'
                                : carrier.id === 'unitedhealthcare'
                                  ? 'insurance-carriers__row-logo--uhc'
                                  : '',
                            ]}
                            width={160}
                            height={48}
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <span class="insurance-carriers__row-name">{carrier.name}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                )}

                <div class="scroll-reveal scroll-reveal--delay-1 mt-12 sm:mt-14">
                  <label for="carrier-search" class="why-kicker block text-center">
                    Search all carriers
                  </label>
                  <div class="insurance-carriers__search mt-5">
                    <input
                      id="carrier-search"
                      type="search"
                      name="carrier-search"
                      placeholder="Search by carrier name…"
                      autocomplete="off"
                      spellcheck="false"
                      aria-controls="carrier-results"
                    />
                  </div>

                  <div
                    class="insurance-carriers__filters mt-5"
                    role="group"
                    aria-label="Filter carriers by status"
                    data-carrier-filters
                  >
                    <span class="insurance-carriers__filters-label">Filter by:</span>
                    <button type="button" class="insurance-carriers__filter is-active" data-status-filter="all" aria-pressed="true">
                      All
                    </button>
                    <button type="button" class="insurance-carriers__filter" data-status-filter="active" aria-pressed="false">
                      Active
                    </button>
                    <button type="button" class="insurance-carriers__filter" data-status-filter="coming-soon" aria-pressed="false">
                      Coming soon
                    </button>
                  </div>

                  <div class="insurance-carriers__list-panel mt-6">
                    <div
                      class="insurance-carriers__list-wrap"
                      tabindex="0"
                      role="region"
                      aria-label="Insurance carrier results"
                      data-carrier-scroll
                    >
                      <ul
                        id="carrier-results"
                        class="insurance-carriers__list"
                        role="list"
                        data-carrier-list
                      >
                        {searchableCarriers.map((carrier) => (
                          <li
                            class="insurance-carriers__item"
                            data-carrier-item
                            data-name={carrier.name.toLowerCase()}
                            data-aliases={carrier.aliases.join(' ').toLowerCase()}
                            data-status={carrier.status}
                          >
                            <span class="insurance-carriers__item-name">{carrier.name}</span>
                            <span class="insurance-carriers__item-status">
                              {statusLabel(carrier.status)}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div class="insurance-carriers__list-fade" aria-hidden="true" data-carrier-fade></div>
                    <p class="insurance-carriers__list-hint" aria-hidden="true" data-carrier-hint>
                      <span>Scroll for more plans</span>
                      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path
                          d="M4 6l4 4 4-4"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </p>
                  </div>

                  <p
                    id="carrier-empty"
                    class="insurance-carriers__empty mt-6 hidden text-center text-sm text-sage-dark/65"
                    hidden
                  >
                    No carriers match your search. Contact us and we&apos;ll help you check coverage.
                  </p>
                </div>
              </div>
            )
          }
        </div>
      </div>
    </section>

    <!-- Details -->
    <section class="why-section bg-cream" aria-labelledby="insurance-details-heading">
      <div class="container-page">
        <h2
          id="insurance-details-heading"
          class="scroll-reveal text-center font-display text-[1.75rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[2.125rem]"
        >
          Fees &amp; policies
        </h2>

        <div class="mx-auto mt-12 grid max-w-5xl gap-4 sm:mt-14 sm:grid-cols-2 sm:gap-6 lg:gap-8">
          {
            detailCards.map((card, index) => (
              <article
                class:list={[
                  'chapter-3__card scroll-reveal',
                  index % 2 === 1 ? 'scroll-reveal--delay-1' : '',
                  index >= 2 ? 'scroll-reveal--delay-2' : '',
                ]}
              >
                <h3 class="font-display text-[1.3rem] font-normal leading-snug tracking-tight text-[#2E2D2A] sm:text-[1.75rem]">
                  {card.title}
                </h3>
                <p class="mt-4 text-sm leading-relaxed text-sage-dark/65 sm:mt-5 sm:text-[0.9375rem]">
                  {card.body}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="why-closing relative overflow-hidden bg-cream pb-24 pt-16 sm:pb-32 sm:pt-20" aria-labelledby="insurance-closing-heading">
      <div class="hero-breathe pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

      <div class="container-page relative z-10">
        <div class="mx-auto max-w-xl text-center">
          <h2 id="insurance-closing-heading" class="sr-only">Questions before your first session</h2>

          <p class="scroll-reveal font-display text-[1.35rem] leading-relaxed text-sage-dark/85 sm:text-[1.65rem]">
            Questions before your first session?
          </p>

          <div class="scroll-reveal scroll-reveal--delay-1 mt-9 sm:mt-10">
            <a href="/faq" class="btn-primary hero-cta why-closing__cta inline-flex">
              Explore the FAQ →
            </a>
          </div>
        </div>
      </div>
    </section>
  </article>

  <script>
    import { initScrollReveal } from '../scripts/scroll-reveal';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    initScrollReveal(reduceMotion);

    const searchInput = document.getElementById('carrier-search') as HTMLInputElement | null;
    const listWrap = document.querySelector<HTMLElement>('[data-carrier-scroll]');
    const scrollHint = document.querySelector<HTMLElement>('[data-carrier-hint]');
    const scrollFade = document.querySelector<HTMLElement>('[data-carrier-fade]');
    const filterButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-status-filter]')
    );
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-carrier-item]'));
    const emptyState = document.getElementById('carrier-empty');
    let activeStatusFilter = 'all';

    const updateScrollHint = () => {
      if (!listWrap) return;

      const canScroll = listWrap.scrollHeight > listWrap.clientHeight + 1;
      const atBottom = listWrap.scrollTop + listWrap.clientHeight >= listWrap.scrollHeight - 8;
      const showHint = canScroll && !atBottom;

      listWrap.classList.toggle('is-scrollable', canScroll);
      listWrap.classList.toggle('is-scrolled-end', atBottom);
      scrollHint?.classList.toggle('is-visible', showHint);
      scrollFade?.classList.toggle('is-visible', showHint);
    };

    if (listWrap) {
      listWrap.addEventListener('scroll', updateScrollHint, { passive: true });
      window.addEventListener('resize', updateScrollHint, { passive: true });
      updateScrollHint();
    }

    const filterCarriers = () => {
      const query = searchInput?.value.trim().toLowerCase() ?? '';
      let visibleCount = 0;

      for (const item of items) {
        const name = item.dataset.name ?? '';
        const aliases = item.dataset.aliases ?? '';
        const status = item.dataset.status ?? '';
        const matchesQuery = !query || name.includes(query) || aliases.includes(query);
        const matchesStatus = activeStatusFilter === 'all' || status === activeStatusFilter;
        const matches = matchesQuery && matchesStatus;
        item.hidden = !matches;
        item.classList.toggle('is-hidden', !matches);
        if (matches) visibleCount += 1;
      }

      if (listWrap) {
        listWrap.scrollTop = 0;
      }

      requestAnimationFrame(updateScrollHint);

      if (emptyState) {
        const showEmpty = visibleCount === 0;
        emptyState.hidden = !showEmpty;
        emptyState.classList.toggle('hidden', !showEmpty);
      }
    };

    for (const button of filterButtons) {
      button.addEventListener('click', () => {
        activeStatusFilter = button.dataset.statusFilter ?? 'all';

        for (const other of filterButtons) {
          const isActive = other === button;
          other.classList.toggle('is-active', isActive);
          other.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        }

        filterCarriers();
      });
    }

    if (items.length > 0) {
      searchInput?.addEventListener('input', filterCarriers);
      searchInput?.addEventListener('search', filterCarriers);
    }
  </script>
</BaseLayout>
