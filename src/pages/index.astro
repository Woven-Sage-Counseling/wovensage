---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedCarrierLogos from '../components/FeaturedCarrierLogos.astro';
import { siteConfig } from '../config/site';

const layers = siteConfig.logos.homeLayers;
---

<BaseLayout
  title={siteConfig.name}
  description="Whatever brought you here — we're glad you made it. Woven Sage Counseling provides therapy in South Florida in person and via secure telehealth throughout Florida."
  botanicalBg={false}
  hideHeader
>
  <div class="home-page">
    <div class="home-page__paper" aria-hidden="true"></div>

    <section class="home-landing" aria-labelledby="home-landing-heading">
      <a href="/" class="home-landing__logo" aria-label={siteConfig.name}>
        <img
          src={`${layers.logoWordmark}?v=3`}
          alt="Woven Sage Counseling"
          width={916}
          height={313}
          class="home-landing__logo-img"
          decoding="async"
          fetchpriority="high"
        />
      </a>

      <a href={siteConfig.signInUrl} class="home-landing__login">
        Log-in
      </a>

      <div class="home-landing__art" aria-hidden="true">
        <img
          src={`${layers.arch}?v=5`}
          alt=""
          width={380}
          height={731}
          class="home-landing__arch"
          loading="eager"
          decoding="async"
        />
        <div class="home-landing__shape home-landing__shape--rect"></div>
      </div>

      <div class="home-landing__stage">
        <div class="home-landing__copy">
          <h1 id="home-landing-heading" class="home-landing__title">
            <img
              src={`${layers.welcomeHeadline}?v=3`}
              alt="You are welcome here"
              width={958}
              height={290}
              class="home-landing__title-img"
              decoding="async"
              fetchpriority="high"
            />
          </h1>

          <div class="home-landing__actions">
            <a href={siteConfig.bookingUrl} class="home-landing__cta">
              Find your therapist
              <span aria-hidden="true">↗</span>
            </a>
            <p class="home-landing__consult">Complimentary 15-minute consultation</p>
          </div>

          <p class="home-landing__trust">
            Florida-based · Secure telehealth · Inclusive &amp; affirming
          </p>
        </div>
      </div>
    </section>

    <section id="coverage" class="home-coverage" aria-labelledby="coverage-teaser-heading">
      <div class="home-coverage__tear home-coverage__tear--top" aria-hidden="true">
        <svg class="home-coverage__tear-svg" viewBox="0 0 1200 56" preserveAspectRatio="none" focusable="false">
          <defs>
            <pattern
              id="home-coverage-paper"
              patternUnits="userSpaceOnUse"
              width="260"
              height="260"
            >
              <image
                href="/images/home-paper-texture.jpg"
                width="260"
                height="260"
                preserveAspectRatio="none"
              ></image>
            </pattern>
          </defs>
          <path
            class="home-coverage__tear-fill"
            d="M0 0h1200v26l-28 9-36-14-38 16-41-12-35 14-40-16-37 11-42 15-36-13-39 16-41-11-35 13-43-15-36 10-40 15-37-12-41 16-38-10-36 13-42-15-35 9-39 16-40-12-36 14-43-15-37 10-38 15-41-11-35 13-42-16-36 9-40 15-38-12-35 14-44-15-36 8-39 16L0 28V0Z"
          ></path>
          <path
            class="home-coverage__tear-grain"
            fill="url(#home-coverage-paper)"
            d="M0 0h1200v26l-28 9-36-14-38 16-41-12-35 14-40-16-37 11-42 15-36-13-39 16-41-11-35 13-43-15-36 10-40 15-37-12-41 16-38-10-36 13-42-15-35 9-39 16-40-12-36 14-43-15-37 10-38 15-41-11-35 13-42-16-36 9-40 15-38-12-35 14-44-15-36 8-39 16L0 28V0Z"
          ></path>
        </svg>
      </div>

      <div class="home-coverage__reveal">
        <div class="container-page relative z-10 mx-auto max-w-4xl px-5 text-center sm:px-8">
          <h2 id="coverage-teaser-heading" class="home-coverage__heading">
            We work with major insurers
          </h2>

          <FeaturedCarrierLogos class="home-coverage__logos mt-10 sm:mt-12" />

          <div class="mt-10 sm:mt-12">
            <a href="/coverage" class="home-coverage__cta inline-flex gap-2">
              See if you&apos;re covered today
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>

      <div class="home-coverage__tear home-coverage__tear--bottom" aria-hidden="true">
        <svg class="home-coverage__tear-svg" viewBox="0 0 1200 56" preserveAspectRatio="none" focusable="false">
          <defs>
            <pattern
              id="home-coverage-paper-bottom"
              patternUnits="userSpaceOnUse"
              width="260"
              height="260"
            >
              <image
                href="/images/home-paper-texture.jpg"
                width="260"
                height="260"
                preserveAspectRatio="none"
              ></image>
            </pattern>
          </defs>
          <path
            class="home-coverage__tear-fill"
            d="M0 56h1200V30l-31-8-35 14-40-15-36 10-42 15-38-11-35 13-44-16-36 9-39 15-41-12-35 14-43-15-37 8-38 16-40-11-36 13-42-15-35 9-41 16-38-12-36 14-43-15-37 10-39 15-40-11-36 13-42-16-35 9-40 15-38-12-35 14-44-15-36 8-39 16-41-11-34 12L0 28v28Z"
          ></path>
          <path
            class="home-coverage__tear-grain"
            fill="url(#home-coverage-paper-bottom)"
            d="M0 56h1200V30l-31-8-35 14-40-15-36 10-42 15-38-11-35 13-44-16-36 9-39 15-41-12-35 14-43-15-37 8-38 16-40-11-36 13-42-15-35 9-41 16-38-12-36 14-43-15-37 10-39 15-40-11-36 13-42-16-35 9-40 15-38-12-35 14-44-15-36 8-39 16-41-11-34 12L0 28v28Z"
          ></path>
        </svg>
      </div>

      <div class="home-coverage__remnant" aria-hidden="true"></div>
    </section>
  </div>
</BaseLayout>
