---
import BaseLayout from '../layouts/BaseLayout.astro';
import PsychologyTodayBadge from '../components/PsychologyTodayBadge.astro';
import { siteConfig } from '../config/site';

const clinician = {
  role: 'Co-Founder & LMHC',
  name: 'Michele Evans',
  credentials: 'LMHC · MCAP · EMDR Trained',
  focus: 'Adults · Young Adults · English · Florida',
  bio: 'Michele believes therapy should feel collaborative, compassionate, and grounded in genuine connection. She works with adults and young adults navigating anxiety, trauma, depression, life transitions, relationship challenges, and substance use concerns. Her approach integrates evidence-based care with warmth and curiosity to help clients move toward meaningful, lasting change.',
} as const;

const founder = {
  role: 'Founder & Operations Director',
  name: 'Christian Evans',
  credentials: 'BS · MMHC',
  bio: 'Christian founded Woven Sage Counseling with a vision to build a thoughtful, connection-centered practice serving clients across South Florida and throughout the state. He leads the practice’s operations, growth, brand, and client experience.',
} as const;
---

<BaseLayout
  title="Meet the Team"
  description="Meet Michele Evans, Co-Founder & LMHC, and Christian Evans, Founder & Operations Director, at Woven Sage Counseling."
  botanicalBg={false}
>
  <article class="team-page why-page">
    <!-- Clinician -->
    <section class="why-section why-section--soft bg-cream" aria-labelledby="team-members-heading">
      <div class="container-page">
        <h1
          id="team-members-heading"
          class="scroll-reveal text-center font-display text-[1.75rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[2.125rem]"
        >
          Meet the team
        </h1>

        <p class="scroll-reveal scroll-reveal--delay-1 mx-auto mt-6 max-w-2xl text-center text-[1.0625rem] leading-relaxed text-sage-dark/72 sm:mt-8 sm:text-lg">
          Every clinician at Woven Sage is selected not only for their clinical expertise, but for their warmth, integrity, and commitment to personalized care.
        </p>

        <div class="mx-auto mt-12 max-w-3xl sm:mt-14">
          <article class="chapter-3__card team-member scroll-reveal scroll-reveal--delay-1">
            <p class="why-kicker">{clinician.role}</p>
            <h2 class="mt-4 font-display text-[1.75rem] font-normal leading-snug tracking-tight text-[#2E2D2A] sm:text-[2.125rem]">
              {clinician.name}
            </h2>
            <p class="team-member__meta mt-3 text-sm leading-relaxed text-sage-dark/65 sm:text-[0.9375rem]">
              {clinician.credentials}
            </p>
            <p class="team-member__meta mt-1 text-sm leading-relaxed text-sage-dark/65 sm:text-[0.9375rem]">
              {clinician.focus}
            </p>
            <p class="mt-5 text-[1.0625rem] leading-relaxed text-sage-dark/78 sm:mt-6 sm:text-lg">
              {clinician.bio}
            </p>
            <div class="mt-6">
              <PsychologyTodayBadge variant="light" />
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Leadership -->
    <section class="why-section bg-cream" aria-labelledby="team-leadership-heading">
      <div class="container-page">
        <h2
          id="team-leadership-heading"
          class="scroll-reveal text-center font-display text-[1.75rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[2.125rem]"
        >
          Leadership
        </h2>

        <div class="mx-auto mt-10 max-w-2xl sm:mt-12">
          <article class="chapter-3__card team-member team-member--leadership scroll-reveal scroll-reveal--delay-1">
            <p class="why-kicker">{founder.role}</p>
            <h3 class="mt-3 font-display text-[1.45rem] font-normal leading-snug tracking-tight text-[#2E2D2A] sm:mt-4 sm:text-[1.75rem]">
              {founder.name}
            </h3>
            <p class="team-member__meta mt-3 text-sm leading-relaxed text-sage-dark/65 sm:text-[0.9375rem]">
              {founder.credentials}
            </p>
            <p class="mt-4 text-[1.0625rem] leading-relaxed text-sage-dark/78 sm:mt-5 sm:text-lg">
              {founder.bio}
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Growing -->
    <section class="why-section team-growing relative overflow-hidden" aria-labelledby="team-careers-heading">
      <div class="team-growing__media pointer-events-none absolute inset-0" aria-hidden="true">
        <img
          src={siteConfig.logos.teamGrowing}
          alt=""
          width={1024}
          height={546}
          class="team-growing__media-img"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="team-growing__scrim pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <div class="container-page relative z-10">
        <div class="mx-auto max-w-2xl text-center">
          <h2
            id="team-careers-heading"
            class="scroll-reveal font-display text-[1.75rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[2.125rem]"
          >
            Growing our team
          </h2>

          <p class="scroll-reveal scroll-reveal--delay-1 mx-auto mt-6 max-w-xl text-[1.0625rem] leading-relaxed text-sage-dark/78 sm:mt-8 sm:text-lg">
            We&apos;re thoughtfully growing our team and looking for compassionate clinicians who share our commitment to connection-centered care.
          </p>

          <p class="scroll-reveal scroll-reveal--delay-1 mx-auto mt-4 max-w-xl text-[1.0625rem] leading-relaxed text-sage-dark/78 sm:text-lg">
            If you&apos;re looking for a place to belong, we&apos;d love to hear from you.
          </p>

          <div class="scroll-reveal scroll-reveal--delay-2 mt-8 sm:mt-10">
            <a href="/careers" class="text-sm font-medium tracking-wide text-sage-dark transition hover:text-sage">
              Join our team →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="why-closing relative overflow-hidden bg-cream pb-24 pt-8 sm:pb-32 sm:pt-12" aria-labelledby="team-closing-heading">
      <div class="hero-breathe pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

      <div class="container-page relative z-10">
        <div class="mx-auto max-w-xl text-center">
          <h2 id="team-closing-heading" class="sr-only">Insurance and fees</h2>

          <p class="scroll-reveal font-display text-[1.35rem] leading-relaxed text-sage-dark/85 sm:text-[1.65rem]">
            Questions about insurance or payment?
          </p>

          <p class="scroll-reveal scroll-reveal--delay-1 mt-2 font-display text-[1.35rem] leading-relaxed text-sage-dark/85 sm:mt-2.5 sm:text-[1.65rem]">
            We&apos;ll walk you through insurance, out-of-network benefits, and private pay options.
          </p>

          <div class="scroll-reveal scroll-reveal--delay-2 mt-9 sm:mt-10">
            <a href="/insurance" class="btn-primary hero-cta why-closing__cta inline-flex">
              Explore insurance →
            </a>
          </div>
        </div>
      </div>
    </section>
  </article>

  <script>
    import { initScrollReveal } from '../scripts/scroll-reveal';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    initScrollReveal(reduceMotion);
  </script>
</BaseLayout>
