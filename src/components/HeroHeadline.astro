---
import { heroTypoVariant } from '../config/heroTypography';

const lineOneClass =
  'hero-line-one block font-display text-[2rem] font-normal leading-[1.22] text-[#2E2D2A] sm:text-[2.75rem] md:text-[3rem]';
---

<h1 id="chapter-1-heading" class="tracking-tight" data-hero-typo={heroTypoVariant}>
  <span class={lineOneClass}>Whatever brought you here…</span>

  {
    heroTypoVariant === 'A' && (
      <span class="hero-line-two hero-line-two--editorial mt-1 block font-display text-[2.25rem] font-bold leading-[1.14] text-sage sm:mt-1.5 sm:text-[3.25rem] md:text-[3.625rem]">
        we're glad you made it.
      </span>
    )
  }

  {
    heroTypoVariant === 'B' && (
      <span class="hero-line-two hero-line-two--signature mt-2 block font-display text-[2.35rem] font-bold leading-[1.08] text-sage sm:mt-2.5 sm:text-[3.35rem] md:text-[3.75rem]">
        we're glad you made it.
      </span>
    )
  }

  {
    heroTypoVariant === 'C' && (
      <span class="hero-line-two hero-line-two--hybrid mt-1 block font-display text-[2.125rem] font-bold leading-[1.2] text-sage sm:mt-1.5 sm:text-[3rem] md:text-[3.25rem]">
        <span class="font-normal">we're glad you </span>
        <span class="font-bold text-[1.06em] text-sage-dark">made it.</span>
      </span>
    )
  }
</h1>
