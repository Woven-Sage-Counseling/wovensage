---
import { siteConfig } from '../config/site';
---

<header class="site-header site-header--glass sticky top-0 z-[100]">
  <div class="site-header__glass-inner container-page flex h-14 items-center justify-between sm:h-16">
    <a href="/" class="site-header__brand-mark group flex shrink-0 items-center" aria-label={siteConfig.name}>
      <img
        src={siteConfig.logos.homeLayers.logoWordmark}
        alt=""
        width={407}
        height={49}
        class="site-header__wordmark"
        decoding="async"
      />
    </a>

    <a href={siteConfig.signInUrl} class="site-header__signin">
      {siteConfig.signInLabel}
    </a>
  </div>
</header>
