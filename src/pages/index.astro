---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedCarrierLogos from '../components/FeaturedCarrierLogos.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title={siteConfig.name}
  description="Whatever brought you here — we're glad you made it. Woven Sage Counseling provides therapy in South Florida in person and via secure telehealth throughout Florida."
  botanicalBg={false}
>
  <!-- Landing -->
  <section
    class="home-landing relative flex min-h-[calc(100svh-3rem)] flex-col overflow-hidden bg-cream sm:min-h-[calc(100vh-3.5rem)]"
    aria-labelledby="home-landing-heading"
  >
    <div class="home-landing__texture pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="relative z-10 flex flex-1 flex-col lg:flex-row lg:items-stretch">
      <div class="flex flex-1 flex-col justify-center px-5 py-12 sm:px-8 sm:py-16 lg:max-w-[48%] lg:py-20 lg:pl-[max(2rem,calc((100vw-72rem)/2+2rem))] lg:pr-8">
        <h1
          id="home-landing-heading"
          class="font-display text-[2.25rem] font-normal leading-[1.15] tracking-tight text-sage-dark sm:text-[3.25rem] md:text-[3.75rem]"
        >
          Whatever brought you here…
          <span class="mt-1 block sm:mt-2">we&apos;re glad you made it.</span>
        </h1>

        <p class="mt-5 max-w-md font-display text-lg leading-snug text-sage-dark/75 sm:mt-6 sm:text-xl">
          A space to feel understood. Support for what comes next.
        </p>

        <div class="mt-8 sm:mt-10">
          <a href={siteConfig.bookingUrl} class="btn-primary home-landing__cta inline-flex gap-2">
            Find your therapist
            <span aria-hidden="true">↗</span>
          </a>
          <p class="mt-3 text-sm text-sage-dark/60">Complimentary 15-minute consultation</p>
        </div>
      </div>

      <div class="relative min-h-[16rem] flex-1 overflow-hidden sm:min-h-[20rem] lg:min-h-0">
        <div class="home-landing__art pointer-events-none absolute inset-0" aria-hidden="true">
          <img
            src={siteConfig.logos.sageBotanicalHero}
            alt=""
            width={682}
            height={1024}
            class="home-landing__sage absolute inset-y-0 right-0 h-full w-auto max-w-none object-cover object-left opacity-90"
            loading="eager"
            decoding="async"
          />
          <div class="home-landing__shape home-landing__shape--arch"></div>
          <div class="home-landing__shape home-landing__shape--rect"></div>
        </div>
      </div>
    </div>

    <p
      class="relative z-10 border-t border-sage-dark/15 px-5 py-4 text-center text-xs tracking-[0.04em] text-sage-dark/65 sm:px-8 sm:text-sm"
    >
      Florida-based · Secure telehealth · Inclusive &amp; affirming
    </p>
  </section>

  <!-- Coverage teaser -->
  <section
    id="coverage"
    class="border-t border-sage-dark/10 bg-cream px-5 py-16 sm:px-8 sm:py-20"
    aria-labelledby="coverage-teaser-heading"
  >
    <div class="container-page mx-auto max-w-4xl text-center">
      <h2
        id="coverage-teaser-heading"
        class="font-display text-[1.65rem] font-normal tracking-tight text-sage-dark sm:text-[2rem]"
      >
        We work with major insurers
      </h2>

      <FeaturedCarrierLogos class="mt-10 sm:mt-12" />

      <div class="mt-10 sm:mt-12">
        <a href="/coverage" class="btn-primary inline-flex gap-2">
          See if you&apos;re covered today
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
