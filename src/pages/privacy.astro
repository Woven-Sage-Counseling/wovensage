---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout title="Privacy Policy" description="Privacy policy for wovensage.com">
  <PageHero title="Privacy Policy" centered />

  <Section>
    <div class="mx-auto max-w-3xl prose-content text-sm">
      <p><em>Last updated: June 2026</em></p>

      <h2 class="font-serif text-xl pt-4">Overview</h2>
      <p>
        {siteConfig.name} ("we," "us," or "our") operates wovensage.com. This policy describes
        how we collect, use, and protect information when you visit our website.
      </p>

      <h2 class="font-serif text-xl pt-4">Information we collect</h2>
      <p>
        Our contact form collects your name, email address, and message content. We do not
        intentionally collect protected health information through this website. Please do not
        submit clinical or medical details via the contact form.
      </p>
      <p>
        We may collect basic analytics data (pages visited, referral source) through privacy-friendly
        analytics tools to improve our site.
      </p>

      <h2 class="font-serif text-xl pt-4">How we use information</h2>
      <p>
        Contact form submissions are used to respond to your inquiry. Analytics data helps us
        understand how visitors use our site.
      </p>

      <h2 class="font-serif text-xl pt-4">Third-party services</h2>
      <p>
        We use third-party services including Formspree (contact form delivery) and Cloudflare
        (hosting and analytics). These services have their own privacy policies governing data they
        process.
      </p>

      <h2 class="font-serif text-xl pt-4">Clinical services</h2>
      <p>
        Therapy and clinical records are managed through secure platforms separate from this
        marketing website. Clinical privacy is governed by applicable healthcare privacy laws
        and your provider's policies.
      </p>

      <h2 class="font-serif text-xl pt-4">Contact</h2>
      <p>
        Questions about this policy? Call{' '}
        <a href={siteConfig.contactPhoneHref} class="text-sage-dark hover:text-sage-dark">
          {siteConfig.contactPhone}
        </a>{' '}
        or email{' '}
        <a href={`mailto:${siteConfig.contactEmail}`} class="text-sage-dark hover:text-sage-dark">
          {siteConfig.contactEmail}
        </a>
        .
      </p>
    </div>
  </Section>
</BaseLayout>
