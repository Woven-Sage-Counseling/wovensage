---
import { siteConfig, navLinks } from '../config/site';
import BookingButton from './BookingButton.astro';
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-accent/40 bg-cream/95 backdrop-blur-md">
  <div class="container-page flex h-14 items-center justify-between gap-4 sm:h-16">
    <a href="/" class="group flex shrink-0 items-center">
      <Logo variant="text" />
      <span class="sr-only">{siteConfig.name}</span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium',
              currentPath === link.href || currentPath.startsWith(link.href + '/')
                ? 'text-sage-dark'
                : 'text-sage-dark/70 hover:text-sage-dark',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      <BookingButton class="hidden sm:inline-flex !px-4 !py-2 text-xs sm:!px-5 sm:text-sm" />
      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex items-center justify-center rounded-lg p-2 text-sage-dark hover:bg-sage-light/40 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-accent/40 bg-cream lg:hidden" aria-label="Mobile navigation">
    <nav class="container-page flex flex-col gap-1 py-4">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium',
              currentPath === link.href
                ? 'bg-sage-light/50 text-sage-dark'
                : 'text-sage-dark/70 hover:bg-sage-light/30 hover:text-sage-dark',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <div class="pt-2">
        <BookingButton class="w-full" />
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
    btn.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
  });
</script>
