---
import { siteConfig, getFormspreeUrl } from '../config/site';

const formspreeUrl = getFormspreeUrl();

const contactReasons = [
  { value: 'insurance-billing', label: 'Insurance or Billing Question' },
  { value: 'general-question', label: 'General Question' },
  { value: 'technical-issue', label: 'Technical Issue' },
  { value: 'careers', label: 'Careers / Joining the Team' },
  { value: 'other', label: 'Other' },
] as const;
---

<div>
  <form
    id="contact-form"
    action={formspreeUrl}
    method="POST"
    class="card space-y-5"
  >
    <div>
      <label for="name" class="mb-1 block text-sm font-medium">Name</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        class="w-full rounded-xl border border-accent/50 bg-cream px-4 py-3 text-sm focus:border-sage-dark focus:outline-none focus:ring-2 focus:ring-sage/30"
      />
    </div>

    <div>
      <label for="email" class="mb-1 block text-sm font-medium">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        class="w-full rounded-xl border border-accent/50 bg-cream px-4 py-3 text-sm focus:border-sage-dark focus:outline-none focus:ring-2 focus:ring-sage/30"
      />
    </div>

    <div>
      <label for="phone" class="mb-1 block text-sm font-medium">
        Phone <span class="font-normal text-sage-dark/50">(optional)</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        autocomplete="tel"
        class="w-full rounded-xl border border-accent/50 bg-cream px-4 py-3 text-sm focus:border-sage-dark focus:outline-none focus:ring-2 focus:ring-sage/30"
      />
    </div>

    <div>
      <label for="reason" class="mb-1 block text-sm font-medium">Reason</label>
      <select
        id="reason"
        name="reason"
        required
        class="w-full rounded-xl border border-accent/50 bg-cream px-4 py-3 text-sm focus:border-sage-dark focus:outline-none focus:ring-2 focus:ring-sage/30"
      >
        <option value="" disabled selected>
          Select a reason…
        </option>
        {
          contactReasons.map((reason) => (
            <option value={reason.label}>{reason.label}</option>
          ))
        }
      </select>
    </div>

    <div>
      <label for="message" class="mb-1 block text-sm font-medium">
        Message <span class="font-normal text-sage-dark/50">(optional)</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        class="w-full rounded-xl border border-accent/50 bg-cream px-4 py-3 text-sm focus:border-sage-dark focus:outline-none focus:ring-2 focus:ring-sage/30"
        placeholder="Anything you would like us to know?"
      ></textarea>
    </div>

    <input type="hidden" name="_subject" id="contact-form-subject" value={`Website inquiry — ${siteConfig.name}`} />

    <p id="contact-form-error" class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      {siteConfig.contactFormErrorMessage}
    </p>

    <button type="submit" id="contact-form-submit" class="btn-primary w-full sm:w-auto">
      {siteConfig.contactFormSubmitLabel}
    </button>
  </form>

  <div id="contact-form-success" class="card hidden text-center" role="status" aria-live="polite">
    <p class="font-serif text-2xl text-sage-dark">{siteConfig.contactFormSuccessTitle}</p>
    <p class="prose-content mx-auto mt-4 max-w-md text-sm">
      {siteConfig.contactFormSuccessMessage}
    </p>
    <p class="mt-6 text-sm text-sage-dark/70">
      Questions? Call{' '}
      <a href={siteConfig.contactPhoneHref} class="text-sage-dark underline hover:text-sage-dark">
        {siteConfig.contactPhone}
      </a>
      , fax {siteConfig.contactFax}, or email{' '}
      <a href={`mailto:${siteConfig.contactEmail}`} class="text-sage-dark underline hover:text-sage-dark">
        {siteConfig.contactEmail}
      </a>
      .
    </p>
  </div>

  <p id="contact-form-footer" class="mt-4 text-center text-xs text-sage-dark/70">
    Prefer to reach out directly? Call{' '}
    <a href={siteConfig.contactPhoneHref} class="text-sage-dark underline hover:text-sage-dark">
      {siteConfig.contactPhone}
    </a>
    , fax {siteConfig.contactFax}, or email{' '}
    <a href={`mailto:${siteConfig.contactEmail}`} class="text-sage-dark underline hover:text-sage-dark">
      {siteConfig.contactEmail}
    </a>
    .
  </p>

  <p class="mt-3 text-center text-xs text-sage-dark/60">
    Looking to schedule?{' '}
    <a href={siteConfig.bookingUrl} class="text-sage-dark underline hover:text-sage-dark">
      Book a consult or appointment
    </a>
    .
  </p>
</div>

<script>
  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('contact-form-submit');
  const successPanel = document.getElementById('contact-form-success');
  const errorPanel = document.getElementById('contact-form-error');
  const footer = document.getElementById('contact-form-footer');
  const reasonSelect = document.getElementById('reason');
  const subjectField = document.getElementById('contact-form-subject');
  const defaultLabel = submitBtn?.textContent?.trim() || 'Send message';
  const siteName = 'Woven Sage Counseling';

  const updateSubject = () => {
    if (!(subjectField instanceof HTMLInputElement) || !(reasonSelect instanceof HTMLSelectElement)) {
      return;
    }

    const reason = reasonSelect.value.trim();
    subjectField.value = reason
      ? `${reason} — ${siteName}`
      : `Website inquiry — ${siteName}`;
  };

  reasonSelect?.addEventListener('change', updateSubject);
  updateSubject();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !(submitBtn instanceof HTMLButtonElement)) return;

    updateSubject();
    errorPanel?.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        form.classList.add('hidden');
        footer?.classList.add('hidden');
        successPanel?.classList.remove('hidden');
        successPanel?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      errorPanel?.classList.remove('hidden');
    } catch {
      errorPanel?.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = defaultLabel;
    }
  });
</script>
