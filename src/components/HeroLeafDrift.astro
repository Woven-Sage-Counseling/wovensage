---
import { siteConfig } from '../config/site';

const leafSrc = siteConfig.logos.leaf;

/** Staggered drift paths — slow, minimal, premium */
const leaves = [
  { left: '8%', delay: '0s', duration: '28s', size: 'w-5', opacity: 0.18, drift: '12px', rotate: '45deg' },
  { left: '22%', delay: '-8s', duration: '34s', size: 'w-4', opacity: 0.14, drift: '-8px', rotate: '-30deg' },
  { left: '38%', delay: '-14s', duration: '31s', size: 'w-6', opacity: 0.16, drift: '16px', rotate: '60deg' },
  { left: '55%', delay: '-5s', duration: '36s', size: 'w-4', opacity: 0.12, drift: '-14px', rotate: '-45deg' },
  { left: '72%', delay: '-20s', duration: '29s', size: 'w-5', opacity: 0.15, drift: '10px', rotate: '35deg' },
  { left: '88%', delay: '-11s', duration: '33s', size: 'w-4', opacity: 0.13, drift: '-6px', rotate: '-55deg' },
  { left: '45%', delay: '-18s', duration: '38s', size: 'w-3', opacity: 0.1, drift: '8px', rotate: '20deg' },
];
---

<div class="hero-leaf-drift pointer-events-none absolute inset-0 z-[1] overflow-hidden" aria-hidden="true">
  {
    leaves.map((leaf) => (
      <img
        src={leafSrc}
        alt=""
        width={32}
        height={32}
        class:list={['hero-leaf-drift__leaf absolute top-0 h-auto', leaf.size]}
        style={{
          left: leaf.left,
          '--leaf-delay': leaf.delay,
          '--leaf-duration': leaf.duration,
          '--leaf-opacity': String(leaf.opacity),
          '--leaf-drift-x': leaf.drift,
          '--leaf-rotate': leaf.rotate,
        }}
        loading="eager"
        decoding="async"
      />
    ))
  }
</div>

<style>
  .hero-leaf-drift__leaf {
    opacity: 0;
    animation: hero-leaf-fall var(--leaf-duration) var(--leaf-delay) linear infinite;
    will-change: transform, opacity;
  }

  @keyframes hero-leaf-fall {
    0% {
      transform: translateY(-8%) translateX(0) rotate(0deg);
      opacity: 0;
    }
    8% {
      opacity: var(--leaf-opacity);
    }
    92% {
      opacity: var(--leaf-opacity);
    }
    100% {
      transform: translateY(105vh) translateX(var(--leaf-drift-x)) rotate(var(--leaf-rotate));
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-leaf-drift {
      display: none;
    }
  }
</style>
