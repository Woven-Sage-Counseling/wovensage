---
const badgeClass = 'inline-flex items-center gap-2';
---

<div class={badgeClass} aria-label="You are welcome here — LGBTQ+ affirming practice">
  <svg class="h-6 w-8 shrink-0" viewBox="0 0 48 32" fill="none" aria-hidden="true">
    <!-- Rainbow stripes (softened for dark footer) -->
    <rect width="48" height="5.33" y="0" fill="#C97B7B" />
    <rect width="48" height="5.33" y="5.33" fill="#D4A06A" />
    <rect width="48" height="5.33" y="10.66" fill="#D4C97B" />
    <rect width="48" height="5.33" y="16" fill="#8FA385" />
    <rect width="48" height="5.33" y="21.33" fill="#7A8FA8" />
    <rect width="48" height="5.34" y="26.66" fill="#9A7A9A" />
    <!-- Progress chevron -->
    <polygon points="0,0 18,16 0,32" fill="#F7F4EE" />
    <polygon points="0,0 14,16 0,32" fill="#E8B4C8" />
    <polygon points="0,0 10,16 0,32" fill="#A8C9D4" />
    <polygon points="0,0 6,16 0,32" fill="#A88B6E" />
    <polygon points="0,0 2,16 0,32" fill="#3D4239" />
  </svg>
  <span class="text-left leading-tight">
    <span class="block text-[0.5rem] font-semibold uppercase tracking-[0.12em] text-cream/55">
      You are
    </span>
    <span class="block font-serif text-sm font-medium text-cream">Welcome here</span>
  </span>
</div>
