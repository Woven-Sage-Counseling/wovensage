---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingButton from '../components/BookingButton.astro';
import SageBranchDecor from '../components/SageBranchDecor.astro';
import { siteConfig } from '../config/site';

const trustItems = [
  'Licensed Florida clinicians',
  'Secure telehealth',
  'Inclusive & affirming care',
] as const;
---

<BaseLayout
  title={siteConfig.name}
  description="Whatever brought you here — we're glad you're here. Woven Sage Counseling is opening soon in South Florida with secure telehealth throughout Florida."
  botanicalBg={false}
>
  <!-- CHAPTER 1 — ARRIVAL -->
  <section
    class="relative flex min-h-[calc(100vh-12rem)] items-center overflow-hidden bg-cream py-20 sm:min-h-[calc(100vh-11rem)] sm:py-28 md:py-32"
    aria-labelledby="chapter-1-heading"
  >
    <SageBranchDecor
      src={siteConfig.logos.sageBranchHeroLeft}
      width={198}
      height={504}
      class="left-0 top-1/2 -translate-y-1/2"
      imgClass="w-28 opacity-[0.14] sm:w-32 md:w-36 md:opacity-[0.16]"
    />
    <SageBranchDecor
      src={siteConfig.logos.sageBranchHero}
      width={198}
      height={504}
      class="right-0 top-1/2 -translate-y-1/2 translate-x-4 sm:translate-x-6"
      imgClass="w-28 opacity-[0.14] sm:w-32 md:w-36 md:opacity-[0.16]"
    />

    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_40%,theme(colors.sage.light/12%),transparent_65%)]"
      aria-hidden="true"
    />

    <div class="container-page relative z-10">
      <div class="mx-auto max-w-2xl text-center lg:max-w-3xl">
        <h1
          id="chapter-1-heading"
          class="font-serif text-[2rem] leading-[1.2] tracking-tight text-sage-dark sm:text-5xl sm:leading-[1.15] md:text-[3.25rem]"
        >
          Whatever brought you here…
          <br />
          <span class="text-sage-dark/90">we're glad you're here.</span>
        </h1>

        <p class="mx-auto mt-8 max-w-lg text-lg leading-relaxed text-sage-dark/65 sm:mt-10 sm:text-xl sm:leading-relaxed">
          You don't have to carry everything alone. When you're ready, we'll be here to listen.
        </p>

        <div class="mt-10 sm:mt-12">
          <BookingButton class="!px-7 !py-3.5" />

          <ul
            class="mx-auto mt-6 flex max-w-md flex-col items-center gap-2 text-[0.8125rem] tracking-wide text-sage-dark/50 sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-5 sm:gap-y-2"
            aria-label="Practice highlights"
          >
            {
              trustItems.map((item) => (
                <li class="inline-flex items-center gap-1.5">
                  <span class="text-sage/80" aria-hidden="true">✓</span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 2 — placeholder -->
  <!-- CHAPTER 3 — placeholder -->
  <!-- CHAPTER 4 — placeholder -->
</BaseLayout>
