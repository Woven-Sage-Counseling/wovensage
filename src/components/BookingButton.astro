---
import { siteConfig } from '../config/site';

interface Props {
  variant?: 'primary' | 'secondary';
  class?: string;
  label?: string;
}

const {
  variant = 'primary',
  class: className = '',
  label = siteConfig.bookingCtaLabel,
} = Astro.props;

const btnClass = variant === 'primary' ? 'btn-primary' : 'btn-secondary';
const href = '/contact#contact-form';
---

<a href={href} class:list={[btnClass, className]}>
  {label}
</a>
