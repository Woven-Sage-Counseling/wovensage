---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingButton from '../components/BookingButton.astro';
import HeroHeadline from '../components/HeroHeadline.astro';
import { siteConfig } from '../config/site';

/**
 * Typography experiment: change variant in src/config/heroTypography.ts
 *   A = Editorial  |  B = Signature  |  C = Hybrid
 */
---

<BaseLayout
  title={siteConfig.name}
  description="Whatever brought you here — we're glad you made it. Woven Sage Counseling is opening soon in South Florida with secure telehealth throughout Florida."
  botanicalBg={false}
>
  <!-- CHAPTER 1 — ARRIVAL -->
  <section
    class="relative flex min-h-[calc(100vh-9rem)] justify-center overflow-hidden bg-cream pb-20 pt-[15vh] sm:min-h-[calc(100vh-8.5rem)] sm:pb-24 sm:pt-[17vh] md:pt-[18vh]"
    aria-labelledby="chapter-1-heading"
  >
    <div class="hero-breathe pointer-events-none absolute inset-0 z-0" aria-hidden="true"></div>

    <div
      class="pointer-events-none absolute inset-y-0 left-0 z-0 flex items-center select-none"
      aria-hidden="true"
    >
      <div class="-ml-[18%] translate-y-6 sm:-ml-[14%] sm:translate-y-8">
        <div id="sage-parallax" class="sage-parallax will-change-transform">
          <img
            src={siteConfig.logos.sageBotanicalHero}
            alt=""
            width={682}
            height={1024}
            class="sage-enter block h-[130vh] w-auto max-w-none"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>

    <div class="container-page relative z-10 pl-[min(40vw,12rem)] sm:pl-[min(36vw,16rem)] md:pl-[min(32vw,18rem)] lg:pl-[min(28vw,20rem)]">
      <div class="ml-auto max-w-2xl text-center lg:max-w-3xl">
        <HeroHeadline />

        <div class="hero-fade hero-fade--rest">
          <p class="mx-auto mt-10 max-w-md text-lg leading-relaxed text-sage-dark/60 sm:mt-11 sm:text-xl">
            You don't have to carry everything by yourself anymore.
          </p>

          <div class="mt-12 sm:mt-14">
            <BookingButton class="!px-7 !py-3.5" />

            <p
              class="mx-auto mt-5 flex max-w-xl flex-nowrap items-center justify-center gap-x-2.5 overflow-x-auto text-[0.625rem] tracking-[0.05em] text-sage-dark/45 sm:mt-6 sm:gap-x-3 sm:text-[0.6875rem] sm:tracking-[0.06em]"
              aria-label="Practice highlights"
            >
              <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap">
                <span class="text-sage/70" aria-hidden="true">✓</span>
                Licensed in Florida
              </span>
              <span class="hidden text-sage-dark/20 sm:inline" aria-hidden="true">·</span>
              <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap">
                <span class="text-sage/70" aria-hidden="true">✓</span>
                Secure telehealth
              </span>
              <span class="hidden text-sage-dark/20 sm:inline" aria-hidden="true">·</span>
              <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap">
                <span class="text-sage/70" aria-hidden="true">✓</span>
                Inclusive & affirming
              </span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 2 — placeholder -->
  <!-- CHAPTER 3 — placeholder -->
  <!-- CHAPTER 4 — placeholder -->
</BaseLayout>

<script>
  const sageParallax = document.getElementById('sage-parallax');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (sageParallax && !reduceMotion) {
    const maxShiftPx = 28;
    const maxScrollPx = Math.min(520, window.innerHeight * 0.7);

    const updateSageParallax = () => {
      const progress = Math.min(Math.max(window.scrollY / maxScrollPx, 0), 1);
      sageParallax.style.transform = `translate3d(${-maxShiftPx * progress}px, 0, 0)`;
    };

    updateSageParallax();
    window.addEventListener('scroll', updateSageParallax, { passive: true });
    window.addEventListener('resize', updateSageParallax, { passive: true });
  }
</script>
