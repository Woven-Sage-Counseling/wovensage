---
import { siteConfig } from '../config/site';

interface Props {
  variant?: 'text' | 'monogram' | 'main';
  class?: string;
}

const { variant = 'text', class: className = '' } = Astro.props;

const logos = {
  text: {
    src: siteConfig.logos.textHeader,
    width: 320,
    height: 59,
    wrapperClass: 'logo-header',
    imgClass: '',
  },
  monogram: {
    src: siteConfig.logos.monogram,
    width: 48,
    height: 48,
    wrapperClass: '',
    imgClass: 'h-10 w-10',
  },
  main: {
    src: siteConfig.logos.main,
    width: 320,
    height: 288,
    wrapperClass: 'logo-hero',
    imgClass: '',
  },
}[variant];
---

{
  logos.wrapperClass ? (
    <div class:list={[logos.wrapperClass, className]}>
      <img
        src={logos.src}
        alt={siteConfig.name}
        width={logos.width}
        height={logos.height}
        class={logos.imgClass}
        loading={variant === 'main' ? 'eager' : 'lazy'}
        decoding="async"
      />
    </div>
  ) : (
    <img
      src={logos.src}
      alt={siteConfig.name}
      width={logos.width}
      height={logos.height}
      class:list={[logos.imgClass, className]}
      loading={variant === 'main' ? 'eager' : 'lazy'}
      decoding="async"
    />
  )
}
