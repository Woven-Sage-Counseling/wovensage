---
import { heroTypoVariant } from '../config/heroTypography';

const lineOneClass =
  'hero-line-one hero-fade hero-fade--line1 block font-display text-[1.625rem] font-normal leading-[1.22] text-[#2E2D2A] sm:text-[2.75rem] md:text-[3rem]';

const lineTwoClass =
  'hero-line-two hero-fade hero-fade--line2 mt-1 block w-full text-right font-display text-[1.625rem] font-normal leading-[1.22] text-[#8C9B89] sm:mt-1.5 sm:w-fit sm:ml-auto sm:text-[2.75rem] md:text-[3rem]';
---

<h1
  id="chapter-1-heading"
  class="mx-auto w-full max-w-[16.5rem] tracking-tight sm:w-fit sm:max-w-none"
  data-hero-typo={heroTypoVariant}
>
  <span class={lineOneClass}>Whatever brought you here…</span>

  {
    heroTypoVariant === 'A' && (
      <span class:list={[lineTwoClass, 'hero-line-two--editorial']}>we're glad you made it.</span>
    )
  }

  {
    heroTypoVariant === 'B' && (
      <span class:list={[lineTwoClass, 'hero-line-two--signature mt-2 sm:mt-2.5']}>
        we're glad you made it.
      </span>
    )
  }

  {
    heroTypoVariant === 'C' && (
      <span class:list={[lineTwoClass, 'hero-line-two--hybrid']}>we're glad you made it.</span>
    )
  }
</h1>
