---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingButton from '../components/BookingButton.astro';
import HeroHeadline from '../components/HeroHeadline.astro';
import { siteConfig } from '../config/site';

/**
 * Typography experiment: change variant in src/config/heroTypography.ts
 *   A = Editorial  |  B = Signature  |  C = Hybrid
 */
const chapter2Messages = [
  {
    line1: 'Healing doesn’t always begin with answers.',
    line2: 'Sometimes it begins with finally feeling safe enough to rest.',
  },
  {
    line1: 'Healing doesn’t have to happen all at once.',
    line2: 'Sometimes it begins with a single honest conversation.',
  },
  {
    line1: 'Healing isn’t about having all the answers.',
    line2: 'Sometimes it’s about asking for help.',
  },
];

const chapter3Cards = [
  {
    headline: ['When your mind', 'won’t slow down.'],
    category: 'Anxiety & Stress',
    description:
      'Constant worry, overthinking, burnout, or feeling overwhelmed by life’s demands.',
  },
  {
    headline: ['When the past', 'still feels present.'],
    category: 'Trauma & Healing',
    description:
      'Processing difficult experiences, rebuilding safety, and moving forward at your own pace.',
  },
  {
    headline: ['When connection', 'feels complicated.'],
    category: 'Relationships',
    description:
      'Strengthening communication, repairing trust, or navigating life’s most important relationships.',
  },
  {
    headline: ['When life no longer', 'feels like yours.'],
    category: 'Life Transitions',
    description:
      'New beginnings, grief, identity, career changes, parenthood, or simply figuring out what’s next.',
  },
];
---

<BaseLayout
  title={siteConfig.name}
  description="Whatever brought you here — we're glad you made it. Woven Sage Counseling is opening soon in South Florida with secure telehealth throughout Florida."
  botanicalBg={false}
>
  <!-- CHAPTER 1 — ARRIVAL -->
  <section
    class="chapter-1-hero relative flex min-h-[calc(100svh-9rem)] items-center justify-end overflow-hidden bg-cream max-sm:px-4 sm:min-h-[calc(100vh-8.5rem)] sm:items-stretch sm:justify-center sm:px-0 sm:pb-24 sm:pt-[20vh] md:pt-[21vh]"
    aria-labelledby="chapter-1-heading"
  >
    <div class="hero-breathe pointer-events-none absolute inset-0 z-0" aria-hidden="true"></div>

    <div
      class="chapter-1-hero__sage pointer-events-none absolute inset-0 z-0 select-none sm:inset-x-auto sm:left-0 sm:flex sm:items-center"
      aria-hidden="true"
    >
      <div class="chapter-1-hero__sage-inner sm:-ml-[14%] sm:translate-y-8">
        <div id="sage-parallax" class="sage-parallax will-change-transform">
          <img
            src={siteConfig.logos.sageBotanicalHero}
            alt=""
            width={682}
            height={1024}
            class="sage-enter block w-auto max-w-none"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>

    <div class="container-page relative z-10 sm:pl-[min(36vw,16rem)] md:pl-[min(32vw,18rem)] lg:pl-[min(28vw,20rem)]">
      <div class="chapter-1-hero__content sm:ml-auto sm:max-w-2xl lg:max-w-3xl">
        <HeroHeadline />

        <div class="hero-fade hero-fade--rest chapter-1-hero__rest">
          <p class="mx-auto mt-8 max-w-[16rem] text-base leading-relaxed text-sage-dark/65 max-sm:mx-0 max-sm:ml-auto max-sm:text-right sm:mt-11 sm:max-w-md sm:text-xl">
            <span class="block">You’ve already taken the first step.</span>
            <span class="block">We’ll take the next ones together.</span>
          </p>

          <div class="mt-5 sm:mt-7">
            <BookingButton class="hero-cta" />

            <p
              class="chapter-1-hero__trust mx-auto mt-5 flex max-w-[15rem] flex-col items-center justify-center gap-y-2 text-[0.625rem] tracking-[0.05em] text-sage-dark/50 max-sm:mx-0 max-sm:ml-auto max-sm:items-end sm:mt-6 sm:max-w-xl sm:flex-row sm:flex-nowrap sm:items-center sm:gap-x-3 sm:gap-y-0 sm:overflow-x-auto sm:text-[0.6875rem] sm:tracking-[0.06em]"
              aria-label="Practice highlights"
            >
              <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap">
                <span class="text-sage/70" aria-hidden="true">✓</span>
                Licensed in Florida
              </span>
              <span class="hidden text-sage-dark/20 sm:inline" aria-hidden="true">·</span>
              <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap">
                <span class="text-sage/70" aria-hidden="true">✓</span>
                Secure telehealth
              </span>
              <span class="hidden text-sage-dark/20 sm:inline" aria-hidden="true">·</span>
              <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap">
                <span class="text-sage/70" aria-hidden="true">✓</span>
                Inclusive & affirming
              </span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 2 — REST -->
  <section id="chapter-2" class="chapter-2 relative w-full" aria-labelledby="chapter-2-heading">
    <div class="chapter-2__media relative w-full overflow-hidden">
      <div id="chapter-2-parallax" class="chapter-2__parallax will-change-transform">
        <img
          src={siteConfig.logos.chapter2Rest}
          alt="A white cat resting peacefully among sage and lavender in warm light"
          width={1024}
          height={538}
          class="block h-auto w-full"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="chapter-2__vignette pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="chapter-2__grain pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="absolute inset-0 flex items-center justify-center px-5 py-8 sm:px-8 sm:py-12">
      <div id="chapter-2-messages" class="chapter-2__messages w-full max-w-3xl">
        {
          chapter2Messages.map((message, index) => (
            <h2
              id={index === 0 ? 'chapter-2-heading' : undefined}
              class:list={[
                'chapter-2__heading chapter-2__message text-center font-display text-[1.375rem] font-normal leading-snug tracking-tight text-cream sm:text-[2.25rem] md:text-[2.75rem]',
              ]}
              aria-hidden={index === 0 ? 'false' : 'true'}
              data-message-index={index}
            >
              <span class="block">{message.line1}</span>
              <span class="mt-3 block sm:mt-4">{message.line2}</span>
            </h2>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CHAPTER 3 — BELONGING -->
  <section
    id="chapter-3"
    class="chapter-3 relative bg-cream px-5 py-20 sm:px-8 sm:py-28 md:py-32"
    aria-labelledby="chapter-3-heading"
  >
    <div class="hero-breathe pointer-events-none absolute inset-0 z-0" aria-hidden="true"></div>

    <div class="container-page relative z-10">
      <header class="chapter-3__intro mx-auto max-w-3xl text-center">
        <h2
          id="chapter-3-heading"
          class="scroll-reveal font-display text-[1.45rem] font-normal leading-[1.2] tracking-tight text-[#2E2D2A] sm:text-[2.125rem] md:text-[2.55rem]"
        >
          <span class="block">Whatever you’re carrying...</span>
          <span class="mt-2 block sm:mt-3">...you don’t have to carry it alone.</span>
        </h2>

        <p
          class="scroll-reveal scroll-reveal--delay-1 mx-auto mt-6 max-w-[19rem] text-[0.9375rem] leading-relaxed text-sage-dark/78 sm:mt-10 sm:max-w-2xl sm:text-lg"
        >
          <span class="block">Therapy isn’t only for moments of crisis.</span>
          <span class="block sm:mt-1">
            Sometimes it’s about finding clarity, healing old wounds, strengthening relationships, or
            creating space to breathe again.
          </span>
        </p>
      </header>

      <div class="chapter-3__grid mx-auto mt-14 grid max-w-5xl gap-4 sm:mt-20 sm:grid-cols-2 sm:gap-6 lg:gap-8">
        {
          chapter3Cards.map((card, index) => (
            <article
              class:list={[
                'chapter-3__card scroll-reveal',
                index % 2 === 1 ? 'scroll-reveal--delay-1' : '',
                index >= 2 ? 'scroll-reveal--delay-2' : '',
              ]}
            >
              <h3 class="chapter-3__card-headline font-display text-[1.3rem] font-normal leading-snug tracking-tight text-[#2E2D2A] sm:text-[1.75rem]">
                <span class="block">{card.headline[0]}</span>
                <span class="block">{card.headline[1]}</span>
              </h3>
              <p class="chapter-3__card-category mt-4 sm:mt-5">
                {card.category}
              </p>
              <p class="chapter-3__card-description mt-4 text-sm leading-relaxed text-sage-dark/65 sm:mt-5 sm:text-[0.9375rem]">
                {card.description}
              </p>
            </article>
          ))
        }
      </div>

      <div class="scroll-reveal scroll-reveal--delay-2 mt-14 text-center sm:mt-20">
        <p class="chapter-3__cta-prelude mx-auto mb-7 max-w-[18rem] font-display text-[1.0625rem] leading-relaxed text-sage-dark/72 sm:mb-9 sm:max-w-md sm:text-xl">
          <span class="block">You don’t need to know exactly where to begin.</span>
          <span class="mt-2 block">We’ll meet you where you are.</span>
        </p>
        <a href="/services" class="btn-primary hero-cta inline-flex">
          Explore how we can support you →
        </a>
      </div>
    </div>
  </section>

  <!-- CHAPTER 4 — placeholder -->
</BaseLayout>

<script>
  import { initChapter2Messages } from '../scripts/chapter2-messages';
  import { initScrollReveal } from '../scripts/scroll-reveal';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const sageParallax = document.getElementById('sage-parallax');

  if (sageParallax && !reduceMotion) {
    const maxShiftPx = 28;
    const maxScrollPx = Math.min(520, window.innerHeight * 0.7);

    const updateSageParallax = () => {
      const progress = Math.min(Math.max(window.scrollY / maxScrollPx, 0), 1);
      sageParallax.style.transform = `translate3d(${-maxShiftPx * progress}px, 0, 0)`;
    };

    updateSageParallax();
    window.addEventListener('scroll', updateSageParallax, { passive: true });
    window.addEventListener('resize', updateSageParallax, { passive: true });
  }

  const chapter2 = document.getElementById('chapter-2');
  const chapter2Parallax = document.getElementById('chapter-2-parallax');

  if (chapter2 && chapter2Parallax && !reduceMotion) {
    const maxShiftPx = 20;

    const updateChapter2Parallax = () => {
      const rect = chapter2.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      const progress = (viewportHeight - rect.top) / (viewportHeight + rect.height);
      const clamped = Math.min(Math.max(progress, 0), 1);
      const offset = (clamped - 0.5) * maxShiftPx * 2;

      chapter2Parallax.style.transform = `translate3d(0, ${offset.toFixed(2)}px, 0)`;
    };

    updateChapter2Parallax();
    window.addEventListener('scroll', updateChapter2Parallax, { passive: true });
    window.addEventListener('resize', updateChapter2Parallax, { passive: true });
  }

  initChapter2Messages(reduceMotion);
  initScrollReveal(reduceMotion);
</script>
