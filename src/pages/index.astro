---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedCarrierLogos from '../components/FeaturedCarrierLogos.astro';
import { siteConfig } from '../config/site';

const layers = siteConfig.logos.homeLayers;
---

<BaseLayout
  title={siteConfig.name}
  description="Whatever brought you here — we're glad you made it. Woven Sage Counseling provides therapy in South Florida in person and via secure telehealth throughout Florida."
  botanicalBg={false}
  hideHeader
>
  <div class="home-page">
    <div class="home-page__textured">
      <div class="home-page__paper" aria-hidden="true"></div>

      <section class="home-landing" aria-labelledby="home-landing-heading">
      <a href="/" class="home-landing__logo" aria-label={siteConfig.name}>
        <img
          src={`${layers.logoWordmark}?v=3`}
          alt="Woven Sage Counseling"
          width={916}
          height={313}
          class="home-landing__logo-img"
          decoding="async"
          fetchpriority="high"
        />
      </a>

      <a href={siteConfig.signInUrl} class="home-landing__login">
        Log-in
      </a>

      <div class="home-landing__art" aria-hidden="true">
        <img
          src={`${layers.threadFigure}?v=1`}
          alt=""
          width={1536}
          height={1024}
          class="home-landing__figure"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="home-landing__stage">
        <div class="home-landing__copy">
          <h1 id="home-landing-heading" class="home-landing__title">
            <img
              src={`${layers.welcomeHeadline}?v=3`}
              alt="You are welcome here"
              width={958}
              height={290}
              class="home-landing__title-img"
              decoding="async"
              fetchpriority="high"
            />
          </h1>

          <div class="home-landing__actions">
            <a href={siteConfig.bookingUrl} class="home-landing__cta">
              Find your therapist
              <span aria-hidden="true">↗</span>
            </a>
            <p class="home-landing__consult">Therapy for who you are... and who you&apos;re becoming.</p>
          </div>
        </div>
      </div>

      <a
        href="#coverage"
        class="home-landing__scroll"
        data-home-scroll-hint
        aria-label="Scroll to coverage"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 9l6 6 6-6"
          ></path>
        </svg>
      </a>
    </section>

    <section id="coverage" class="home-coverage" aria-labelledby="coverage-teaser-heading">
      <div class="home-coverage__window">
        <div class="home-coverage__edge home-coverage__edge--top" aria-hidden="true"></div>
        <div class="home-coverage__reveal">
          <div class="container-page relative z-10 mx-auto max-w-4xl px-5 text-center sm:px-8">
            <h2 id="coverage-teaser-heading" class="home-coverage__heading">
              We work with major insurers
            </h2>

            <FeaturedCarrierLogos class="home-coverage__logos mt-10 sm:mt-12" />

            <div class="mt-10 sm:mt-12">
              <a href="/coverage" class="home-coverage__cta inline-flex gap-2">
                See if you&apos;re covered today
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
        <div class="home-coverage__edge home-coverage__edge--bottom" aria-hidden="true"></div>
      </div>
    </section>

      <section class="home-quote" aria-roledescription="carousel" aria-label="Therapist quotes" data-home-quote>
        <div class="home-quote__viewport">
          <div class="home-quote__track" data-quote-track>
            <article class="home-quote__slide is-active" data-quote-slide aria-label="1 of 3" aria-hidden="false">
              <div class="home-quote__layout">
                <figure class="home-quote__portrait">
                  <img
                    src="/images/home-layers/tape-tl.png?v=1"
                    alt=""
                    width={915}
                    height={273}
                    class="home-quote__tape home-quote__tape--tl"
                    aria-hidden="true"
                    decoding="async"
                  />
                  <img
                    src="/images/home-layers/tape-br.png?v=1"
                    alt=""
                    width={1038}
                    height={387}
                    class="home-quote__tape home-quote__tape--br"
                    aria-hidden="true"
                    decoding="async"
                  />
                  <img
                    src="/images/michele-editorial-portrait.jpg?v=2"
                    alt="Michele L. Evans, Co-Founder and LMHC at Woven Sage Counseling"
                    width={819}
                    height={1024}
                    class="home-quote__img"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>

                <blockquote class="home-quote__copy">
                  <p class="home-quote__text">
                    &ldquo;You are more than what you&apos;ve been through. Let&apos;s rip the page and
                    rewrite your story together&rdquo;
                  </p>
                  <footer class="home-quote__attr">— Michele L. Evans, Co-Founder &amp; LMHC</footer>
                </blockquote>
              </div>
            </article>

            <article class="home-quote__slide" data-quote-slide aria-label="2 of 3" aria-hidden="true">
              <div class="home-quote__layout">
                <figure class="home-quote__portrait">
                  <img
                    src="/images/home-layers/tape-tl.png?v=1"
                    alt=""
                    width={915}
                    height={273}
                    class="home-quote__tape home-quote__tape--tl"
                    aria-hidden="true"
                    decoding="async"
                  />
                  <img
                    src="/images/home-layers/tape-br.png?v=1"
                    alt=""
                    width={1038}
                    height={387}
                    class="home-quote__tape home-quote__tape--br"
                    aria-hidden="true"
                    decoding="async"
                  />
                  <img
                    src="/images/christian-editorial-portrait.jpg"
                    alt="Christian Evans, Co-Founder and CEO of Woven Sage Counseling"
                    width={819}
                    height={1024}
                    class="home-quote__img"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>

                <blockquote class="home-quote__copy">
                  <p class="home-quote__text">
                    &ldquo;Finding the right support shouldn&apos;t feel like another obstacle. We&apos;re
                    building a better way forward.&rdquo;
                  </p>
                  <footer class="home-quote__attr">— Christian Evans, Co-Founder &amp; CEO</footer>
                </blockquote>
              </div>
            </article>

            <article class="home-quote__slide" data-quote-slide aria-label="3 of 3" aria-hidden="true">
              <div class="home-quote__message">
                <p class="home-quote__message-text">We are expanding our team.</p>
                <p class="home-quote__message-sub">
                  More therapists are joining Woven Sage soon — stay tuned.
                </p>
              </div>
            </article>
          </div>
        </div>

        <nav class="home-quote__pager" aria-label="Quote slides">
          <button type="button" class="home-quote__pager-btn" data-quote-prev aria-label="Previous quote">
            &lt;
          </button>
          <div class="home-quote__pager-pages" role="tablist" aria-label="Quote pages">
            <button
              type="button"
              class="home-quote__pager-page is-active"
              data-quote-page="0"
              aria-label="Show quote 1"
              aria-current="true"
            >
              1
            </button>
            <button
              type="button"
              class="home-quote__pager-page"
              data-quote-page="1"
              aria-label="Show quote 2"
            >
              2
            </button>
            <button
              type="button"
              class="home-quote__pager-page"
              data-quote-page="2"
              aria-label="Show quote 3"
            >
              3
            </button>
          </div>
          <button type="button" class="home-quote__pager-btn" data-quote-next aria-label="Next quote">
            &gt;
          </button>
        </nav>
      </section>

      <section class="home-facts" aria-label="Therapy facts">
        <div class="home-facts__grid">
          <div class="home-facts__slot" aria-hidden="true"></div>
          <div class="home-facts__slot" aria-hidden="true"></div>
          <div class="home-facts__slot">
            <article class="home-facts__hole">
              <div class="home-facts__fill">
                <p class="home-facts__kicker">Did you know?</p>
                <p class="home-facts__text">
                  Consistent therapy can reshape how the brain responds to stress — small weekly
                  sessions compound into lasting change.
                </p>
              </div>
              <img
                src="/images/home-layers/paper-punch-hole.png?v=5"
                alt=""
                width={2000}
                height={1121}
                class="home-facts__punch"
                loading="lazy"
                decoding="async"
              />
            </article>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  const hint = document.querySelector('[data-home-scroll-hint]');
  if (hint instanceof HTMLElement) {
    const update = () => {
      hint.classList.toggle('is-hidden', window.scrollY > 36);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  const quoteRoot = document.querySelector('[data-home-quote]');
  if (quoteRoot instanceof HTMLElement) {
    const track = quoteRoot.querySelector('[data-quote-track]');
    const slides = [...quoteRoot.querySelectorAll('[data-quote-slide]')];
    const pages = [...quoteRoot.querySelectorAll('[data-quote-page]')];
    const prevBtn = quoteRoot.querySelector('[data-quote-prev]');
    const nextBtn = quoteRoot.querySelector('[data-quote-next]');
    let index = 0;

    const goTo = (nextIndex: number) => {
      if (!(track instanceof HTMLElement) || slides.length === 0) return;
      index = (nextIndex + slides.length) % slides.length;
      track.style.transform = `translateX(-${index * 100}%)`;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      pages.forEach((page, i) => {
        const active = i === index;
        page.classList.toggle('is-active', active);
        if (active) page.setAttribute('aria-current', 'true');
        else page.removeAttribute('aria-current');
      });
    };

    prevBtn?.addEventListener('click', () => goTo(index - 1));
    nextBtn?.addEventListener('click', () => goTo(index + 1));
    pages.forEach((page) => {
      page.addEventListener('click', () => {
        const pageIndex = Number((page as HTMLElement).dataset.quotePage);
        if (!Number.isNaN(pageIndex)) goTo(pageIndex);
      });
    });
  }
</script>

