---
import { siteConfig } from '../config/site';
import Logo from './Logo.astro';
---

<header class="site-header sticky top-0 z-[100] bg-sage-dark">
  <div class="container-page flex h-12 items-center sm:h-14">
    <a
      href="/"
      class="group flex shrink-0 items-center opacity-95 transition hover:opacity-100"
      aria-label={siteConfig.name}
    >
      <Logo variant="text" class="brightness-0 invert" />
    </a>
  </div>
</header>
