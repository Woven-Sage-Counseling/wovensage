---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const { note } = siteConfig.insurance;
const insuranceApiUrl = `${siteConfig.providerPortalUrl}/api/public/insurance`;

const detailCards = [
  {
    title: 'Private pay',
    body: 'Private pay is available for clients who prefer to pay out of pocket or whose insurance is not in network. Contact us for current session rates and availability.',
  },
  {
    title: 'Payment methods',
    body: 'We accept major credit and debit cards. HSA and FSA cards are typically accepted for eligible mental health services — confirm with your card provider.',
  },
  {
    title: 'Cancellation policy',
    body: 'We ask for at least 24 hours’ notice if you need to cancel or reschedule. Late cancellations and missed appointments may be subject to a fee.',
  },
  {
    title: 'Good faith estimate',
    body: 'If you do not have health insurance or choose not to use it, you have the right under the No Surprises Act to receive a Good Faith Estimate of expected costs. You can request one before scheduling or anytime during care. If your final bill is at least $400 more than the estimate, you may have the right to dispute the charge. Contact us to request an estimate.',
  },
] as const;
---

<BaseLayout
  title="Insurance & Fees"
  description="Insurance, private pay, and payment options at Woven Sage Counseling. Search accepted plans and learn how care can be covered."
  botanicalBg={false}
>
  <article class="insurance-page why-page">
    <section class="why-section why-section--soft bg-cream" aria-labelledby="insurance-carriers-heading">
      <div class="container-page">
        <div class="mx-auto max-w-5xl">
          <h1
            id="insurance-carriers-heading"
            class="scroll-reveal text-center font-display text-[1.75rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[2.125rem]"
          >
            Insurance
          </h1>

          <p class="scroll-reveal scroll-reveal--delay-1 mx-auto mt-6 max-w-2xl text-center text-[1.0625rem] leading-relaxed text-sage-dark/72 sm:mt-8 sm:text-lg">
            {note}
          </p>

          <div
            class="insurance-carriers mt-12 sm:mt-14"
            data-public-insurance
            data-api-url={insuranceApiUrl}
          >
            <p class="scroll-reveal scroll-reveal--delay-1 text-center text-sm text-sage-dark/65" data-insurance-loading>
              Loading insurance networks…
            </p>
            <p class="mt-10 hidden text-center italic text-sage-dark/65 sm:mt-12" data-insurance-empty hidden>
              Accepted insurance networks will appear here as they are added.
            </p>
            <p class="mt-6 hidden text-center text-sm text-red-800" data-insurance-error hidden></p>

            <div class="hidden scroll-reveal scroll-reveal--delay-1" data-insurance-content hidden>
              <label for="carrier-search" class="why-kicker block text-center">
                Search insurance companies
              </label>
              <div class="insurance-carriers__search mt-5">
                <input
                  id="carrier-search"
                  type="search"
                  name="carrier-search"
                  placeholder="Search by insurance company…"
                  autocomplete="off"
                  spellcheck="false"
                  aria-controls="insurance-results"
                  data-insurance-search
                />
              </div>

              <div
                class="insurance-carriers__filters mt-5"
                role="group"
                aria-label="Filter networks by availability"
                data-insurance-filters
              >
                <span class="insurance-carriers__filters-label">Show:</span>
                <button type="button" class="insurance-carriers__filter is-active" data-section-filter="all" aria-pressed="true">
                  All
                </button>
                <button type="button" class="insurance-carriers__filter" data-section-filter="in-network" aria-pressed="false">
                  Currently in network
                </button>
                <button type="button" class="insurance-carriers__filter" data-section-filter="coming-soon" aria-pressed="false">
                  Coming soon
                </button>
              </div>

              <div id="insurance-results" class="mt-8 space-y-10" data-insurance-results></div>

              <p
                class="insurance-carriers__empty mt-6 hidden text-center text-sm text-sage-dark/65"
                data-insurance-search-empty
                hidden
              >
                No companies match your search. Contact us and we&apos;ll help you check coverage.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="why-section bg-cream" aria-labelledby="insurance-details-heading">
      <div class="container-page">
        <h2
          id="insurance-details-heading"
          class="scroll-reveal text-center font-display text-[1.75rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[2.125rem]"
        >
          Fees &amp; policies
        </h2>

        <div class="mx-auto mt-12 grid max-w-5xl gap-4 sm:mt-14 sm:grid-cols-2 sm:gap-6 lg:gap-8">
          {
            detailCards.map((card, index) => (
              <article
                class:list={[
                  'chapter-3__card scroll-reveal',
                  index % 2 === 1 ? 'scroll-reveal--delay-1' : '',
                  index >= 2 ? 'scroll-reveal--delay-2' : '',
                ]}
              >
                <h3 class="font-display text-[1.3rem] font-normal leading-snug tracking-tight text-[#2E2D2A] sm:text-[1.75rem]">
                  {card.title}
                </h3>
                <p class="mt-4 text-sm leading-relaxed text-sage-dark/65 sm:mt-5 sm:text-[0.9375rem]">
                  {card.body}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="why-closing relative overflow-hidden bg-cream pb-24 pt-16 sm:pb-32 sm:pt-20" aria-labelledby="insurance-closing-heading">
      <div class="hero-breathe pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

      <div class="container-page relative z-10">
        <div class="mx-auto max-w-xl text-center">
          <h2 id="insurance-closing-heading" class="sr-only">Questions before your first session</h2>

          <p class="scroll-reveal font-display text-[1.35rem] leading-relaxed text-sage-dark/85 sm:text-[1.65rem]">
            Questions before your first session?
          </p>

          <div class="scroll-reveal scroll-reveal--delay-1 mt-9 sm:mt-10">
            <a href="/faq" class="btn-primary hero-cta why-closing__cta inline-flex">
              Explore the FAQ →
            </a>
          </div>
        </div>
      </div>
    </section>
  </article>

  <script>
    import { initScrollReveal } from '../scripts/scroll-reveal';

    type InsuranceNetwork = { groupId: string; groupName: string; sortOrder: number };
    type InsurancePayload = {
      inNetwork: InsuranceNetwork[];
      comingSoon: InsuranceNetwork[];
    };

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    initScrollReveal(reduceMotion);

    function escapeHtml(value: string): string {
      return value
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;');
    }

    function renderNetworkList(networks: InsuranceNetwork[]): string {
      if (networks.length === 0) return '';
      const items = networks
        .map(
          (network) => `<li
            class="insurance-carriers__item"
            data-insurance-network
            data-search-text="${escapeHtml(network.groupName.toLowerCase())}"
          >
            <span class="insurance-carriers__item-name">${escapeHtml(network.groupName)}</span>
          </li>`,
        )
        .join('');
      return `<ul class="insurance-carriers__list" role="list">${items}</ul>`;
    }

    function renderInsurance(payload: InsurancePayload): string {
      const sections = [];
      if (payload.inNetwork.length > 0) {
        sections.push(`<section data-insurance-section="in-network">
          <h2 class="font-display text-[1.35rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[1.55rem]">Currently in network</h2>
          <div class="mt-5">${renderNetworkList(payload.inNetwork)}</div>
        </section>`);
      }
      if (payload.comingSoon.length > 0) {
        sections.push(`<section data-insurance-section="coming-soon">
          <h2 class="font-display text-[1.35rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[1.55rem]">Coming soon</h2>
          <div class="mt-5">${renderNetworkList(payload.comingSoon)}</div>
          <p class="mt-5 text-sm leading-relaxed text-sage-dark/65">
            Networks listed as Coming soon are still undergoing credentialing and aren&apos;t currently available for in-network billing. Participation and effective dates aren&apos;t guaranteed until credentialing is complete.
          </p>
        </section>`);
      }
      return sections.join('');
    }

    function applyInsuranceFilters(root: HTMLElement): void {
      const query =
        root.querySelector('[data-insurance-search]') instanceof HTMLInputElement
          ? root.querySelector<HTMLInputElement>('[data-insurance-search]')!.value.trim().toLowerCase()
          : '';
      const activeFilter =
        root.querySelector('[data-insurance-filters] .is-active') instanceof HTMLElement
          ? (root.querySelector('[data-insurance-filters] .is-active') as HTMLElement).dataset.sectionFilter ?? 'all'
          : 'all';

      let visibleNetworks = 0;
      root.querySelectorAll('[data-insurance-section]').forEach((section) => {
        if (!(section instanceof HTMLElement)) return;
        const sectionKey = section.dataset.insuranceSection ?? '';
        const sectionMatches =
          activeFilter === 'all' ||
          (activeFilter === 'in-network' && sectionKey === 'in-network') ||
          (activeFilter === 'coming-soon' && sectionKey === 'coming-soon');

        let sectionVisible = 0;
        section.querySelectorAll('[data-insurance-network]').forEach((network) => {
          if (!(network instanceof HTMLElement)) return;
          const haystack = network.dataset.searchText ?? '';
          const show = sectionMatches && (!query || haystack.includes(query));
          network.hidden = !show;
          network.classList.toggle('is-hidden', !show);
          if (show) {
            sectionVisible += 1;
            visibleNetworks += 1;
          }
        });

        section.hidden = !sectionMatches || sectionVisible === 0;
        section.classList.toggle('hidden', !sectionMatches || sectionVisible === 0);
      });

      const searchEmpty = root.querySelector('[data-insurance-search-empty]');
      if (searchEmpty instanceof HTMLElement) {
        const show = visibleNetworks === 0;
        searchEmpty.hidden = !show;
        searchEmpty.classList.toggle('hidden', !show);
      }
    }

    async function loadPublicInsurance(root: HTMLElement): Promise<void> {
      const apiUrl = root.dataset.apiUrl ?? '';
      const loading = root.querySelector('[data-insurance-loading]');
      const empty = root.querySelector('[data-insurance-empty]');
      const error = root.querySelector('[data-insurance-error]');
      const content = root.querySelector('[data-insurance-content]');
      const results = root.querySelector('[data-insurance-results]');

      try {
        const response = await fetch(apiUrl, { headers: { Accept: 'application/json' } });
        const payload = (await response.json()) as {
          ok?: boolean;
          inNetwork?: InsuranceNetwork[];
          comingSoon?: InsuranceNetwork[];
          error?: string;
        };
        loading?.classList.add('hidden');
        if (loading instanceof HTMLElement) loading.hidden = true;

        if (!response.ok || !payload.ok || !payload.inNetwork || !payload.comingSoon) {
          throw new Error(payload.error || 'Unable to load insurance networks.');
        }

        const hasNetworks = payload.inNetwork.length > 0 || payload.comingSoon.length > 0;

        if (!hasNetworks) {
          empty?.classList.remove('hidden');
          if (empty instanceof HTMLElement) empty.hidden = false;
          return;
        }

        if (results instanceof HTMLElement) {
          results.innerHTML = renderInsurance({
            inNetwork: payload.inNetwork,
            comingSoon: payload.comingSoon,
          });
        }
        content?.classList.remove('hidden');
        if (content instanceof HTMLElement) content.hidden = false;

        root.querySelectorAll('[data-section-filter]').forEach((button) => {
          button.addEventListener('click', () => {
            root.querySelectorAll('[data-section-filter]').forEach((other) => {
              const isActive = other === button;
              other.classList.toggle('is-active', isActive);
              other.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            });
            applyInsuranceFilters(root);
          });
        });

        root.querySelector('[data-insurance-search]')?.addEventListener('input', () => applyInsuranceFilters(root));
        applyInsuranceFilters(root);
      } catch (loadError) {
        loading?.classList.add('hidden');
        if (loading instanceof HTMLElement) loading.hidden = true;
        if (error instanceof HTMLElement) {
          error.textContent =
            loadError instanceof Error ? loadError.message : 'Unable to load insurance networks right now.';
          error.hidden = false;
          error.classList.remove('hidden');
        }
      }
    }

    document.querySelectorAll('[data-public-insurance]').forEach((root) => {
      if (root instanceof HTMLElement) void loadPublicInsurance(root);
    });
  </script>
</BaseLayout>
