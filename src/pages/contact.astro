---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import ContactForm from '../components/ContactForm.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="Contact"
  description={`Contact ${siteConfig.name}. Reach us at ${siteConfig.contactPhone} or ${siteConfig.contactEmail} to express your interest during prelaunch.`}
>
  <PageHero
    title="Contact us"
    description="Share your interest — we are in prelaunch and will reach out when we open officially."
    centered
  />

  <Section>
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="font-serif text-2xl">Get in touch</h2>
        <p class="prose-content mt-4 text-sm">
          Use the form to express your interest in working with Woven Sage Counseling. We are
          currently in prelaunch and will contact you when we begin accepting clients.
        </p>
        <p class="mt-4 text-sm">
          <strong>Email:</strong>{' '}
          <a href={`mailto:${siteConfig.contactEmail}`} class="text-sage-dark hover:text-sage-dark">
            {siteConfig.contactEmail}
          </a>
        </p>
        <p class="mt-2 text-sm">
          <strong>Phone:</strong>{' '}
          <a href={siteConfig.contactPhoneHref} class="text-sage-dark hover:text-sage-dark">
            {siteConfig.contactPhone}
          </a>
        </p>
      </div>

      <ContactForm />
    </div>
  </Section>
</BaseLayout>
