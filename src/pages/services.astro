---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';

const serviceCards = [
  {
    title: 'Individual Therapy',
    description:
      'Personalized support for anxiety, depression, stress, trauma, life transitions, self-esteem, and emotional wellness.',
  },
  {
    title: 'Couples Therapy',
    description:
      'Strengthen communication, rebuild trust, deepen connection, and navigate conflict together.',
  },
  {
    title: 'Trauma & EMDR',
    description:
      'Evidence-based trauma treatment designed to help you process difficult experiences and move forward with greater confidence.',
  },
  {
    title: 'Women’s Mental Health',
    description:
      'Support for anxiety, relationships, motherhood, identity, burnout, and major life transitions.',
  },
  {
    title: 'LGBTQ+ Affirming Therapy',
    description:
      'An inclusive, affirming space for LGBTQ+ individuals exploring identity, relationships, and emotional well-being.',
  },
  {
    title: 'Consultation',
    description:
      'A relaxed first conversation to understand your goals and determine whether Woven Sage is the right fit.',
  },
] as const;

const sessionNotes = [
  {
    label: 'Session length',
    body: 'Most sessions are 45–60 minutes and are tailored to your needs and treatment goals.',
  },
  {
    label: 'How we work',
    body: 'Our clinicians draw from evidence-based approaches, including EMDR, with additional modalities added as the team grows.',
  },
  {
    label: 'Finding the right fit',
    body: 'In your initial consultation, we look carefully at whether our care is the right match. If another path would serve you better, we’ll help you find it.',
  },
] as const;
---

<BaseLayout
  title="Services"
  description="Therapy services at Woven Sage Counseling — individual, couples, family, group therapy, assessments, and more."
  botanicalBg={false}
>
  <article class="services-page why-page">
    <!-- Hero -->
    <section class="why-hero why-hero--photo relative overflow-hidden" aria-labelledby="services-hero-heading">
      <div class="why-hero__media pointer-events-none absolute inset-0" aria-hidden="true">
        <img
          src={siteConfig.logos.servicesHero}
          alt=""
          width={1536}
          height={1024}
          class="why-hero__media-img"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <div class="why-hero__scrim pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="why-hero__grain pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <p class="scroll-reveal why-kicker why-hero__kicker">Services</p>

      <div class="container-page relative z-10">
        <div class="why-hero__inner mx-auto max-w-2xl text-center">
          <h1
            id="services-hero-heading"
            class="scroll-reveal font-display text-[2.385rem] font-normal leading-[1.14] tracking-tight text-[#2E2D2A] sm:text-[3.18rem] md:text-[3.71rem]"
          >
            Care that meets you <em class="italic text-sage">where you are</em>.
          </h1>

          <div class="scroll-reveal scroll-reveal--delay-1 why-hero__copy mx-auto mt-12 max-w-xl sm:mt-14 md:mt-16">
            <p>
              Therapy for individuals, couples, families, and groups.
            </p>
            <p class="why-hero__copy-close">
              In person in South Florida, and securely online throughout Florida.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- What we offer -->
    <section class="why-section why-section--soft services-offer bg-cream" aria-labelledby="services-offer-heading">
      <div class="container-page">
        <div class="mx-auto max-w-5xl">
          <h2
            id="services-offer-heading"
            class="scroll-reveal text-center font-display text-[1.75rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[2.125rem]"
          >
            Find the support that’s right for you.
          </h2>

          <div class="mt-12 grid gap-4 sm:mt-14 sm:grid-cols-2 sm:gap-6 lg:gap-8">
            {
              serviceCards.map((service, index) => (
                <article
                  class:list={[
                    'chapter-3__card scroll-reveal',
                    index % 2 === 1 ? 'scroll-reveal--delay-1' : '',
                    index >= 2 ? 'scroll-reveal--delay-2' : '',
                  ]}
                >
                  <h3 class="font-display text-[1.3rem] font-normal leading-snug tracking-tight text-[#2E2D2A] sm:text-[1.75rem]">
                    {service.title}
                  </h3>
                  <p class="mt-4 text-sm leading-relaxed text-sage-dark/65 sm:mt-5 sm:text-[0.9375rem]">
                    {service.description}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Areas of focus -->
    <section class="why-section services-focus-section bg-cream" aria-labelledby="services-focus-heading">
      <div class="container-page">
        <div class="services-focus mx-auto max-w-3xl text-center">
          <h2
            id="services-focus-heading"
            class="scroll-reveal font-display text-[1.75rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[2.125rem]"
          >
            Areas we commonly support
          </h2>

          <p class="scroll-reveal scroll-reveal--delay-1 mx-auto mt-6 max-w-xl text-[1.0625rem] leading-relaxed text-sage-dark/72 sm:mt-8 sm:text-lg">
            Every person’s story is unique, but these are some of the areas we most often work with.
          </p>

          <ul class="services-focus__list scroll-reveal scroll-reveal--delay-1 mt-10 sm:mt-12" role="list">
            {
              siteConfig.specialties.map((item) => (
                <li class="services-focus__item">{item}</li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Session details -->
    <section class="why-section why-section--soft bg-cream" aria-labelledby="services-details-heading">
      <div class="container-page">
        <div class="mx-auto max-w-2xl">
          <h2
            id="services-details-heading"
            class="scroll-reveal text-center font-display text-[1.75rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[2.125rem]"
          >
            Session details
          </h2>

          <div class="services-notes mt-12 space-y-10 sm:mt-14 sm:space-y-12">
            {
              sessionNotes.map((note, index) => (
                <div
                  class:list={[
                    'scroll-reveal text-center',
                    index > 0 ? 'scroll-reveal--delay-1' : '',
                  ]}
                >
                  <p class="why-kicker">{note.label}</p>
                  <p class="mx-auto mt-4 max-w-xl font-display text-[1.2rem] leading-relaxed text-sage-dark/78 sm:text-[1.35rem]">
                    {note.body}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="why-closing relative overflow-hidden bg-cream pb-24 pt-8 sm:pb-32 sm:pt-12" aria-labelledby="services-closing-heading">
      <div class="hero-breathe pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

      <div class="container-page relative z-10">
        <div class="mx-auto max-w-xl text-center">
          <h2 id="services-closing-heading" class="sr-only">Begin with us</h2>

          <p class="scroll-reveal font-display text-[1.35rem] leading-relaxed text-sage-dark/85 sm:text-[1.65rem]">
            You don&apos;t need to know exactly which service fits yet.
          </p>

          <p class="scroll-reveal scroll-reveal--delay-1 mt-4 font-display text-[1.35rem] leading-relaxed text-sage-dark/72 sm:mt-5 sm:text-[1.65rem]">
            We&apos;ll help you find the right place to begin.
          </p>

          <div class="scroll-reveal scroll-reveal--delay-2 mt-9 sm:mt-10">
            <a href="/team" class="btn-primary hero-cta why-closing__cta inline-flex">
              Meet our team →
            </a>
          </div>
        </div>
      </div>
    </section>
  </article>

  <script>
    import { initScrollReveal } from '../scripts/scroll-reveal';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    initScrollReveal(reduceMotion);
  </script>
</BaseLayout>
