---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingButton from '../components/BookingButton.astro';
import HeroHeadline from '../components/HeroHeadline.astro';
import SageBranchDecor from '../components/SageBranchDecor.astro';
import { siteConfig } from '../config/site';

/**
 * Typography experiment: change variant in src/config/heroTypography.ts
 *   A = Editorial  |  B = Signature  |  C = Hybrid
 */
---

<BaseLayout
  title={siteConfig.name}
  description="Whatever brought you here — we're glad you made it. Woven Sage Counseling is opening soon in South Florida with secure telehealth throughout Florida."
  botanicalBg={false}
>
  <!-- CHAPTER 1 — ARRIVAL -->
  <section
    class="relative flex min-h-[calc(100vh-9rem)] justify-center overflow-hidden bg-cream pb-20 pt-[15vh] sm:min-h-[calc(100vh-8.5rem)] sm:pb-24 sm:pt-[17vh] md:pt-[18vh]"
    aria-labelledby="chapter-1-heading"
  >
    <img
      src={siteConfig.logos.main}
      alt=""
      width={586}
      height={623}
      class="pointer-events-none absolute left-1/2 top-[36%] z-0 w-[min(88vw,34rem)] -translate-x-1/2 -translate-y-1/2 select-none opacity-[0.038] blur-[1.5px] sm:w-[min(72vw,38rem)] md:top-[38%]"
      aria-hidden="true"
      loading="eager"
      decoding="async"
    />

    <SageBranchDecor
      src={siteConfig.logos.sageBranchHeroLeft}
      width={198}
      height={504}
      class="left-0 top-1/2 -translate-y-1/2"
      imgClass="w-28 opacity-[0.05] sm:w-32 md:w-36 md:opacity-[0.055]"
    />
    <SageBranchDecor
      src={siteConfig.logos.sageBranchHero}
      width={198}
      height={504}
      class="right-0 top-1/2 -translate-y-1/2 translate-x-4 sm:translate-x-6"
      imgClass="w-28 opacity-[0.05] sm:w-32 md:w-36 md:opacity-[0.055]"
    />

    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_38%,theme(colors.sage.light/10%),transparent_68%)]"
      aria-hidden="true"
    />

    <div class="container-page relative z-10">
      <div class="mx-auto max-w-2xl text-center lg:max-w-3xl">
        <HeroHeadline />

        <p class="mx-auto mt-10 max-w-md text-lg leading-relaxed text-sage-dark/60 sm:mt-11 sm:text-xl">
          You don't have to carry everything by yourself anymore.
        </p>

        <div class="mt-12 sm:mt-14">
          <BookingButton class="!px-7 !py-3.5" />

          <p
            class="mx-auto mt-5 flex max-w-xl flex-nowrap items-center justify-center gap-x-4 overflow-x-auto text-[0.625rem] tracking-[0.05em] text-sage-dark/45 sm:mt-6 sm:gap-x-8 sm:text-[0.6875rem] sm:tracking-[0.06em]"
            aria-label="Practice highlights"
          >
            <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap">
              <span class="text-sage/70" aria-hidden="true">✓</span>
              Licensed in Florida
            </span>
            <span class="hidden text-sage-dark/20 sm:inline" aria-hidden="true">·</span>
            <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap">
              <span class="text-sage/70" aria-hidden="true">✓</span>
              Secure telehealth
            </span>
            <span class="hidden text-sage-dark/20 sm:inline" aria-hidden="true">·</span>
            <span class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap">
              <span class="text-sage/70" aria-hidden="true">✓</span>
              Inclusive & affirming
            </span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 2 — placeholder -->
  <!-- CHAPTER 3 — placeholder -->
  <!-- CHAPTER 4 — placeholder -->
</BaseLayout>
