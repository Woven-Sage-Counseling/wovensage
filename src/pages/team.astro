---
import BaseLayout from '../layouts/BaseLayout.astro';
import PsychologyTodayBadge from '../components/PsychologyTodayBadge.astro';
import { siteConfig } from '../config/site';

const { founder, clinician } = siteConfig.team;

const members = [
  {
    name: founder.name,
    role: founder.title,
    meta: '',
    bio: founder.bio,
    showPsychologyTodayBadge: false,
  },
  {
    name: clinician.name,
    role: clinician.title,
    meta: [clinician.credentials, clinician.pronouns, clinician.languages.join(', '), clinician.license]
      .filter(Boolean)
      .join(' · '),
    bio: `${clinician.bio} ${clinician.specialties}.`,
    showPsychologyTodayBadge: true,
  },
] as const;
---

<BaseLayout
  title="Meet the Team"
  description="Meet the people behind Woven Sage Counseling — Christian Evans, Founder, and Michele Evans, Co-Founder & LMHC."
  botanicalBg={false}
>
  <article class="team-page why-page">
    <!-- Members -->
    <section class="why-section why-section--soft bg-cream" aria-labelledby="team-members-heading">
      <div class="container-page">
        <h1
          id="team-members-heading"
          class="scroll-reveal text-center font-display text-[1.75rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[2.125rem]"
        >
          Meet the team
        </h1>

        <div class="mx-auto mt-12 flex max-w-3xl flex-col gap-6 sm:mt-14 sm:gap-8">
          {
            members.map((member, index) => (
              <article
                class:list={[
                  'chapter-3__card team-member scroll-reveal',
                  index > 0 ? 'scroll-reveal--delay-1' : '',
                ]}
              >
                <p class="why-kicker">{member.role}</p>
                <h2 class="mt-4 font-display text-[1.75rem] font-normal leading-snug tracking-tight text-[#2E2D2A] sm:text-[2.125rem]">
                  {member.name}
                </h2>
                {member.meta && (
                  <p class="team-member__meta mt-3 text-sm leading-relaxed text-sage-dark/65 sm:text-[0.9375rem]">
                    {member.meta}
                  </p>
                )}
                <p class="mt-5 text-[1.0625rem] leading-relaxed text-sage-dark/78 sm:mt-6 sm:text-lg">
                  {member.bio}
                </p>
                {member.showPsychologyTodayBadge && (
                  <div class="mt-6">
                    <PsychologyTodayBadge variant="light" />
                  </div>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Growing -->
    <section class="why-section bg-cream" aria-labelledby="team-careers-heading">
      <div class="container-page">
        <div class="mx-auto max-w-2xl text-center">
          <h2
            id="team-careers-heading"
            class="scroll-reveal font-display text-[1.75rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[2.125rem]"
          >
            Growing our team
          </h2>

          <p class="scroll-reveal scroll-reveal--delay-1 mx-auto mt-6 max-w-xl text-[1.0625rem] leading-relaxed text-sage-dark/72 sm:mt-8 sm:text-lg">
            We&apos;re growing carefully — looking for compassionate clinicians who want to offer thoughtful, connection-centered care across South Florida and beyond.
          </p>

          <p class="scroll-reveal scroll-reveal--delay-1 mx-auto mt-4 max-w-xl text-[1.0625rem] leading-relaxed text-sage-dark/72 sm:text-lg">
            If you&apos;re looking for a place to belong, we&apos;d love to hear from you.
          </p>

          <div class="scroll-reveal scroll-reveal--delay-2 mt-8 sm:mt-10">
            <a href="/careers" class="text-sm font-medium tracking-wide text-sage-dark transition hover:text-sage">
              View careers →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="why-closing relative overflow-hidden bg-cream pb-24 pt-8 sm:pb-32 sm:pt-12" aria-labelledby="team-closing-heading">
      <div class="hero-breathe pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

      <div class="container-page relative z-10">
        <div class="mx-auto max-w-xl text-center">
          <h2 id="team-closing-heading" class="sr-only">Insurance and fees</h2>

          <p class="scroll-reveal font-display text-[1.35rem] leading-relaxed text-sage-dark/85 sm:text-[1.65rem]">
            Wondering how care gets covered?
          </p>

          <p class="scroll-reveal scroll-reveal--delay-1 mt-2 font-display text-[1.35rem] leading-relaxed text-sage-dark/85 sm:mt-2.5 sm:text-[1.65rem]">
            We&apos;ll walk you through insurance and private pay options.
          </p>

          <div class="scroll-reveal scroll-reveal--delay-2 mt-9 sm:mt-10">
            <a href="/insurance" class="btn-primary hero-cta why-closing__cta inline-flex">
              Explore insurance →
            </a>
          </div>
        </div>
      </div>
    </section>
  </article>

  <script>
    import { initScrollReveal } from '../scripts/scroll-reveal';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    initScrollReveal(reduceMotion);
  </script>
</BaseLayout>
