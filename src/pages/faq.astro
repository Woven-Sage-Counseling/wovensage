---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'Do you accept insurance?',
    a: 'Yes. We are in network with many major insurance plans and are continually expanding our network. Visit our Insurance page for the most up-to-date list of accepted plans.',
    link: { href: '/insurance', label: 'Insurance page' },
  },
  {
    q: 'Do you offer self-pay appointments?',
    a: 'Yes. We welcome both insurance and self-pay clients. Please contact us for current private-pay rates.',
  },
  {
    q: 'Do you offer virtual therapy?',
    a: 'Yes. We provide secure telehealth appointments to clients anywhere in Florida, as well as in-person sessions in Palm Beach County.',
  },
  {
    q: 'What issues do you help with?',
    a: 'We work with adults and couples experiencing concerns such as:',
    items: [
      'Anxiety',
      'Depression',
      'Trauma & PTSD',
      'Relationship challenges',
      'Stress & burnout',
      'Life transitions',
      'Grief & loss',
      'Women’s issues',
      'Self-esteem',
      'Addiction & recovery',
    ],
  },
  {
    q: 'How long are therapy sessions?',
    a: 'Most therapy sessions last approximately 50–60 minutes.',
  },
  {
    q: 'How soon can I get an appointment?',
    a: 'Appointment availability varies throughout the week. Contact us to discuss current openings and we’ll work to schedule you as soon as possible.',
  },
  {
    q: 'Do you offer a complimentary consult?',
    a: 'Yes. We offer a complimentary 15-minute consult so you can ask questions, share a bit about what you’re looking for, and see whether Woven Sage feels like the right fit before beginning therapy.',
  },
  {
    q: 'What is your cancellation policy?',
    a: 'If you need to cancel or reschedule, we ask for at least 24 hours’ notice to avoid a late cancellation fee.',
  },
  {
    q: 'Is therapy confidential?',
    a: 'Yes. Your privacy is extremely important. All services are provided in accordance with HIPAA and applicable Florida confidentiality laws, with limited legal exceptions.',
  },
  {
    q: 'What should I expect during my first session?',
    a: 'Your first appointment focuses on getting to know you, discussing your goals, reviewing your history, and developing a treatment plan tailored to your needs.',
  },
  {
    q: 'Do you prescribe medication?',
    a: 'No. We provide psychotherapy and counseling services only. If medication may be beneficial, we’re happy to coordinate with your primary care physician or psychiatrist.',
  },
  {
    q: 'How do I schedule an appointment?',
    a: 'You can request an appointment online, call our office, or send us a message through our website. We’ll guide you through the next steps — including a complimentary 15-minute consult if you’d like one — and answer any questions before your first visit.',
  },
] as const;

function renderAnswer(text: string, link?: { href: string; label: string }) {
  if (!link) return text;
  const parts = text.split(link.label);
  if (parts.length < 2) return text;
  return { before: parts[0], after: parts.slice(1).join(link.label), link };
}
---

<BaseLayout
  title="FAQ"
  description="Frequently asked questions about insurance, self-pay, telehealth, scheduling, and what to expect at Woven Sage Counseling."
  botanicalBg={false}
>
  <article class="faq-page why-page">
    <section class="why-section why-section--soft bg-cream" aria-labelledby="faq-heading">
      <div class="container-page">
        <div class="mx-auto max-w-3xl">
          <h1
            id="faq-heading"
            class="scroll-reveal text-center font-display text-[1.75rem] font-normal tracking-tight text-[#2E2D2A] sm:text-[2.125rem]"
          >
            FAQ
          </h1>

          <p class="scroll-reveal scroll-reveal--delay-1 mx-auto mt-6 max-w-2xl text-center text-[1.0625rem] leading-relaxed text-sage-dark/72 sm:mt-8 sm:text-lg">
            Common questions about getting started, coverage, and what care with us looks like.
          </p>

          <div class="faq-list mt-12 sm:mt-14">
            {
              faqs.map((faq, index) => {
                const linked =
                  'link' in faq && faq.link ? renderAnswer(faq.a, faq.link) : null;

                return (
                  <details
                    class:list={[
                      'faq-item scroll-reveal',
                      index % 2 === 1 ? 'scroll-reveal--delay-1' : '',
                      index >= 2 ? 'scroll-reveal--delay-2' : '',
                    ]}
                  >
                    <summary class="faq-item__question">
                      <span>{faq.q}</span>
                      <span class="faq-item__icon" aria-hidden="true"></span>
                    </summary>
                    <div class="faq-item__answer">
                      {typeof linked === 'object' && linked ? (
                        <p>
                          {linked.before}
                          <a href={linked.link.href} class="faq-item__link">
                            {linked.link.label}
                          </a>
                          {linked.after}
                        </p>
                      ) : (
                        <p>{faq.a}</p>
                      )}
                      {'items' in faq && faq.items && (
                        <ul class="faq-item__list">
                          {faq.items.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </details>
                );
              })
            }
          </div>
        </div>
      </div>
    </section>

    <section class="why-closing relative overflow-hidden bg-cream pb-24 pt-16 sm:pb-32 sm:pt-20" aria-labelledby="faq-closing-heading">
      <div class="hero-breathe pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>

      <div class="container-page relative z-10">
        <div class="mx-auto max-w-xl text-center">
          <h2 id="faq-closing-heading" class="sr-only">Contact us</h2>

          <p class="scroll-reveal font-display text-[1.35rem] leading-relaxed text-sage-dark/85 sm:text-[1.65rem]">
            Still have a question we didn&apos;t cover?
          </p>

          <div class="scroll-reveal scroll-reveal--delay-1 mt-9 sm:mt-10">
            <a href="/contact" class="btn-primary hero-cta why-closing__cta inline-flex">
              Contact us →
            </a>
          </div>
        </div>
      </div>
    </section>
  </article>

  <script>
    import { initScrollReveal } from '../scripts/scroll-reveal';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    initScrollReveal(reduceMotion);
  </script>
</BaseLayout>
