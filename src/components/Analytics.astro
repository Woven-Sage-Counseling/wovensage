---
/** Track Headway booking clicks before redirect */
---

<script is:inline>
  window.trackHeadwayClick = function (source) {
    try {
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'headway_book_click', {
          event_category: 'conversion',
          event_label: source || 'website',
        });
      }
      if (typeof window.plausible === 'function') {
        window.plausible('Headway Book Click', { props: { source: source || 'website' } });
      }
      window.dispatchEvent(
        new CustomEvent('headway_book_click', { detail: { source: source || 'website' } })
      );
    } catch (_) {
      /* analytics should never block navigation */
    }
  };
</script>
