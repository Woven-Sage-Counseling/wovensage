---
import { heroTypoVariant } from '../config/heroTypography';

const lineOneClass =
  'hero-line-one block font-display text-[2rem] font-normal leading-[1.22] text-[#2E2D2A] sm:text-[2.75rem] md:text-[3rem]';

const lineTwoClass =
  'hero-line-two mt-1 block w-fit ml-auto translate-x-3 font-display text-[2.25rem] font-normal leading-[1.14] text-sage sm:mt-1.5 sm:translate-x-4 sm:text-[3.25rem] md:text-[3.625rem]';
---

<h1 id="chapter-1-heading" class="tracking-tight" data-hero-typo={heroTypoVariant}>
  <span class={lineOneClass}>Whatever brought you here…</span>

  {
    heroTypoVariant === 'A' && (
      <span class:list={[lineTwoClass, 'hero-line-two--editorial']}>we're glad you made it.</span>
    )
  }

  {
    heroTypoVariant === 'B' && (
      <span class:list={[lineTwoClass, 'hero-line-two--signature mt-2 sm:mt-2.5']}>
        we're glad you made it.
      </span>
    )
  }

  {
    heroTypoVariant === 'C' && (
      <span class:list={[lineTwoClass, 'hero-line-two--hybrid']}>we're glad you made it.</span>
    )
  }
</h1>
